<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><title>Feather Fury — Stability Update 14.1</title><style>
:root{color-scheme:dark;--ink:#142b35;--gold:#ffe1a0;--muted:#b5c9c0}*{box-sizing:border-box}body{margin:0;background:#0e2029;color:#fff4dc;font-family:system-ui,sans-serif}button,input{font:inherit}button{cursor:pointer;touch-action:manipulation;color:inherit;border:1px solid #ffffff25;background:#ffffff12;border-radius:10px;min-height:44px;padding:8px 12px;font-weight:700}button:disabled{opacity:.38;cursor:default}button:focus-visible{outline:3px solid #ffcf79;outline-offset:2px}#game{max-width:1100px;margin:auto;background:#182f37;min-height:100dvh}.top{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:12px 16px;background:linear-gradient(120deg,#385c51,#192f3c)}h1{margin:0;font-size:clamp(17px,3.4vw,26px);font-style:italic;font-weight:1000;letter-spacing:-1px;color:var(--gold);line-height:1}.edition{font-size:9px;letter-spacing:1.5px;color:var(--muted);margin-top:5px}.wallet{display:flex;align-items:center;gap:10px;font-size:12px;font-weight:800;color:var(--gold)}.arena{position:relative;background:#87cbdc;overflow:hidden}canvas{display:block;width:100%;height:auto;aspect-ratio:16/10;touch-action:none}.hud{position:absolute;top:8px;left:8px;right:8px;display:flex;gap:5px;align-items:stretch;pointer-events:none}.hud>div{background:#15333dcc;border:1px solid #ffffff25;border-radius:10px;padding:6px 9px}.hud small{display:block;font-size:9px;font-weight:800;color:#cee0d6}.hud strong{font-size:18px;line-height:1.2;font-variant-numeric:tabular-nums}.meter{height:7px;background:#142932;border-radius:8px;margin-top:7px;overflow:hidden}.meter i{display:block;background:linear-gradient(90deg,#e99a3b,#ffea91);height:100%}.hud button{pointer-events:auto;background:#16343fce}.boss{position:absolute;top:65px;left:25%;right:25%;text-align:center;font-size:10px;font-weight:900;pointer-events:none;text-shadow:0 1px 2px #17272e}.boss .meter i{background:#f38169}.world{position:absolute;bottom:8px;left:10px;right:10px;display:flex;justify-content:space-between;font-size:10px;font-weight:700;text-shadow:0 1px 3px #17232a;pointer-events:none}.tabs{display:flex;gap:5px;padding:8px 10px 0;align-items:center}.tabs button{font-size:12px;min-height:44px}.tabs .active{background:#536a55;border-color:#e8cb83;color:#fff0ba}.swap{margin-left:auto}.deck{display:flex;gap:7px;overflow-x:auto;padding:9px 12px;scrollbar-width:thin;scroll-snap-type:x proximity}.card{position:relative;flex:0 0 76px;scroll-snap-align:start;background:linear-gradient(#607b67,#2d494a);border:2px solid #859b80;border-radius:12px;padding:4px;line-height:1.25;text-align:center}.card.active{border-color:#ffe1a0;background:linear-gradient(#a99b64,#536a4f)}.card.magic{background:linear-gradient(#8a74a9,#474467);border-color:#ad9fc6}.card svg{display:block;width:49px;height:40px;margin:auto}.card b,.card small{display:block;font-size:10px}.card small{color:#e0e7d5}.qty{position:absolute;top:3px;right:3px;background:#142b35;border-radius:5px;font-size:10px;padding:1px 4px}.glyph{font-size:30px;height:40px;line-height:40px}.bottom{display:flex;align-items:center;gap:9px;padding:0 12px 12px}.info{flex:1;font-size:11px;line-height:1.4;color:var(--muted)}.info b{display:block;color:#fff2c5;font-size:12px}.gold{background:linear-gradient(#eec368,#ba8036);border-color:#f6d99b;color:#382a1c;border-bottom:3px solid #80572b}.overlay{position:fixed;inset:0;z-index:20;background:#10232ed1;display:grid;place-items:center;padding:12px;backdrop-filter:blur(4px)}.overlay[hidden],[hidden]{display:none!important}.panel{width:min(100%,480px);max-height:94dvh;overflow:auto;background:linear-gradient(145deg,#fff8e7,#e9cca0);color:#4c3829;border:3px solid #fff8e6;border-radius:20px;padding:16px;text-align:center;box-shadow:0 20px 50px #071923aa}.panel h2{margin:4px 0;font-size:24px;font-weight:950;letter-spacing:-.6px}.panel p{font-size:13px;line-height:1.5;margin:8px 0 12px;color:#755a40}.panel button{background:#fff6de;color:#62472e;border:1px solid #c7ab7c}.panel .go,.panel .buy{background:#578749;color:#fff;border-color:#8eb574;border-bottom:3px solid #385c32}.go{margin-top:12px;padding:10px 24px}.menu,.map,.grid{display:grid;gap:7px;margin:10px 0}.menu{grid-template-columns:repeat(2,1fr)}.map{grid-template-columns:repeat(5,1fr)}.grid{grid-template-columns:repeat(4,1fr)}.tile{padding:8px 2px;min-height:51px}.tile.open{background:#b5d295;color:#315332}.tile small,.mini small{display:block;font-size:10px}.tile.bossTile{border:2px solid #c48b50}.mini{padding:5px 1px;font-size:11px;min-width:0}.mini.active{border:2px solid #719a55;background:#e3eccb}.mini svg{display:block;width:42px;height:35px;margin:auto}.item,.receipt{border:1px solid #c9af85;border-radius:11px;background:#fff6dfb0;padding:10px;margin:7px 0;font-size:12px;line-height:1.5}.item{display:flex;align-items:center;gap:9px;text-align:left}.item .txt{flex:1;min-width:0}.item b{display:block}.item .buy{white-space:nowrap;font-size:11px}.xp{height:7px;background:#d5c299;border-radius:8px;overflow:hidden;margin-top:6px}.xp i{display:block;background:#7eac61;height:100%}.chapter{width:100%;text-align:left;margin:5px 0}.chapter small{display:block}.stars{color:#ce902d;font-size:30px;letter-spacing:4px;font-weight:900}.toast{position:absolute;bottom:32px;left:50%;transform:translateX(-50%);width:max-content;max-width:90%;padding:7px 11px;background:#203944eb;border-radius:8px;font-size:12px;pointer-events:none}.footer{font-size:10px;color:#9db3ab;padding:0 12px 8px;text-align:center}@media(max-width:410px){.wallet{gap:5px;font-size:10px}.top{padding:10px}.hud>div{padding:5px 6px}.hud strong{font-size:14px}.hud small{font-size:7px}.hud button{min-height:38px;padding:5px 9px}.boss{top:49px}.edition{letter-spacing:.5px}.tabs button{padding:6px 9px}.card{flex-basis:67px}}@media(orientation:landscape) and (max-height:600px){#game{min-height:0;display:grid;grid-template-columns:minmax(0,1fr) 210px;grid-template-rows:auto 1fr auto}.top{grid-column:1/-1;padding:5px 12px}.arena{grid-column:1;grid-row:2/4;align-self:start}.arena canvas{width:min(100%,calc((100dvh - 62px)*1.6));max-height:none;margin:auto}.tabs{grid-column:2;flex-wrap:wrap}.deck{grid-column:2;display:grid;grid-template-columns:repeat(2,1fr);max-height:calc(100dvh - 165px);overflow:auto}.bottom{grid-column:2;flex-wrap:wrap}.footer{display:none}.tabs .swap{margin-left:0}}

:root{--gold:#ffe29c;--muted:#d1e3d7}body{background:radial-gradient(ellipse at 50% 0,#48777c,#122d3a 72%)}#game{background:linear-gradient(#295265,#183b47);box-shadow:0 0 60px #071b2c66}.top{background:linear-gradient(#286784,#19465b);border-bottom:3px solid #133b4e}h1{font-size:clamp(18px,4vw,30px);color:#fff4d6;text-shadow:0 2px #6a4a27,0 4px #102c40}.wallet>span{background:#143f52;border:1px solid #7eacb66b;border-radius:20px;padding:6px 8px;white-space:nowrap}.wallet button,.hud button{background:linear-gradient(#f9df9c,#d69a4e);border:1px solid #fff2cc;border-bottom:4px solid #89572a;color:#503e2f;min-width:40px;font-size:18px}.hud>div{background:linear-gradient(#25576ce8,#17394bdc);border:1px solid #fff5;box-shadow:0 3px 6px #17394c33}.meter{height:10px;border:1px solid #adbbb58c}.meter i{background:linear-gradient(#fff199,#fbc34e 55%,#e49a35)}.tabs{background:#153b4c}.tabs .active{background:linear-gradient(#f3d587,#c59549);color:#483821;border-color:#ffebbe;border-bottom:3px solid #91632f}.deck{background:linear-gradient(#294e5b,#1c3e4c);padding:12px 14px 10px;gap:9px}.card{flex-basis:84px;background:linear-gradient(150deg,#f7e9c8,#c1a46f);border:2px solid #f9e7b7;border-bottom:4px solid #8b6a3e;color:#4d392a;box-shadow:0 3px 0 #0b2635;border-radius:10px}.card svg{width:56px;height:45px;filter:drop-shadow(0 2px 1px #45352142)}.card small{color:#715638}.card.active{background:linear-gradient(#fff7d4,#eed08a);border-color:#fff6bd;box-shadow:0 0 0 2px #f7bb4b,0 4px 0 #96612d;transform:translateY(-2px)}.card.magic{background:linear-gradient(#e1d4ff,#9f8ec7);border-color:#f4e6ff}.qty{background:#61472f;color:#fff8de}.bottom{background:#1c3e4c}.gold{background:linear-gradient(#fff3b5,#f6c460 55%,#d89a3f);border-bottom:4px solid #825325}.panel{background:linear-gradient(#fffae8,#efdbb3);border:4px solid #c39656;border-top-color:#ffe4a5;box-shadow:0 12px 50px #091b28a0,inset 0 0 0 2px #fff7d3}.panel .go,.panel .buy{background:linear-gradient(#a6d67b,#689f46);border-bottom:4px solid #406d32}.menu button{background:linear-gradient(#fff8df,#e4c893);border-bottom:3px solid #b1925e}.worldcard{display:flex;align-items:center;gap:10px;padding:5px!important;overflow:hidden;border:1px solid #c5a16c!important;border-radius:12px!important;background:linear-gradient(#fff7e2,#eddbb5)!important}.world-art{width:83px;height:55px;flex-shrink:0;position:relative;overflow:hidden;border-radius:8px;background:linear-gradient(var(--sky),#fff2d2)}.world-art .sun{position:absolute;top:7px;right:12px;width:19px;height:19px;border-radius:50%;background:#fff2ca}.world-art .hill{position:absolute;width:100px;height:50px;transform:rotate(-12deg);border-radius:55% 45% 0 0}.world-art .h1{left:-18px;bottom:-21px;background:var(--hill)}.world-art .h2{left:35px;bottom:-29px;background:var(--grass)}.chapter-no{position:absolute;left:6px;top:4px;color:#fff;font-size:12px;text-shadow:0 1px 3px #293b43}.chapter-copy{flex:1;text-align:left}.chapter-copy b{font-size:14px}.chapter-copy small{font-size:10px;margin-top:3px}.chev{font-size:24px;color:#b08a50;padding-right:8px}.journey{height:450px;position:relative;overflow:hidden;border:2px solid #c8b07e;border-radius:15px;background:linear-gradient(var(--sky),#fff5d9)}.journey>svg{position:absolute;inset:0;width:100%;height:100%}.route-node{position:absolute;transform:translate(-50%,-50%);min-width:63px;min-height:39px;padding:3px 8px!important;line-height:1.05;border-radius:20px!important;border:2px solid #b59b70!important;background:#e1cba4!important;color:#8a7555!important;box-shadow:0 3px 0 #7b684b70}.route-node strong{display:block;font-size:14px}.route-node small{display:block;font-size:10px}.route-node.open{background:linear-gradient(#d9efaf,#8db965)!important;color:#345629!important;border-color:#f2f4cf!important}.route-node.current{outline:3px solid #ffcf64;outline-offset:1px}.route-node.bossTile{border-color:#d28d4c!important}.route-node:disabled{opacity:.75;filter:saturate(.45)}.footer{background:#1c3e4c}.info{color:#dae5d9}
