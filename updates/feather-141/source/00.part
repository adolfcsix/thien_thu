@media(orientation:landscape) and (max-height:600px){#game{grid-template-rows:auto auto 1fr auto}.arena{grid-row:2/5}.deck{max-height:calc(100dvh - 160px);padding:5px 8px;gap:5px}.card{min-height:66px}.card svg{height:29px}.tabs{padding:4px}.bottom{padding:4px 8px}.top{padding:5px 10px}.journey{height:350px}}

/* Feather Fury 12: arcade visual system, gameplay remains independent. */
body{background:radial-gradient(ellipse at 45% 5%,#3b87c3,#102a50 70%)}#game{background:#12364b;box-shadow:0 0 90px #081e38;overflow:hidden}.top{background:linear-gradient(165deg,#2c87bf,#1b4e81 70%,#163d62);border-bottom:3px solid #082e52;min-height:72px;position:relative;padding:8px 13px}.brand{position:relative;display:flex;align-items:center;gap:7px;min-width:0}.brand img{width:clamp(104px,23vw,190px);height:auto;display:block;filter:drop-shadow(0 2px 2px #082c51aa)}.brand .edition{font-size:8px;letter-spacing:.7px;font-weight:800;color:#d7ebf9}.brand h1{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}.wallet>span{background:#092c58;border:1px solid #699dd1;box-shadow:inset 0 2px #fff1;border-radius:20px;color:#fff7dc;padding:6px 10px}.wallet button,.hud button{background:linear-gradient(#ffec99 2%,#ffb538 46%,#e27820 100%);border:2px solid #ffdd87;border-bottom:4px solid #8e431e;box-shadow:0 2px 2px #082d4e55,inset 0 1px #fff6c8;color:#fff;min-width:40px;text-shadow:0 2px #99431e}.arena{background:#6ec7e9}.hud>div{background:linear-gradient(#2466aaec,#102f60e8);border:1px solid #a9d5ff7a;box-shadow:0 3px #15345166;border-radius:12px}.hud small{color:#d5edff}.hud strong{color:white;text-shadow:0 2px #122952}.meter{background:#49283a;border:1px solid #f8ce90;height:12px;box-shadow:inset 0 2px #240d3280}.meter i{background:linear-gradient(#ffec8b,#ffb327 50%,#f47624);box-shadow:inset 0 2px #fff7bc}.world{font-weight:900;font-size:10px;letter-spacing:.3px}.tabs{background:linear-gradient(#96582f,#69401f);border-top:3px solid #c6914e;padding:7px 10px 2px}.tabs button{background:#532f1e;border:1px solid #c89854;color:#ffe3ae;min-height:40px}.tabs .active{background:linear-gradient(#ffe797,#edab43);color:#623219;border-color:#ffe5a4;border-bottom:3px solid #ad6226}.deck{background:repeating-linear-gradient(3deg,#865028 0px,#865028 30px,#774422 31px,#774422 33px);padding:10px 12px 12px;gap:9px;box-shadow:inset 0 5px #5c351d44}.card{flex-basis:91px;background:linear-gradient(145deg,var(--bird-light,#ffe1b4),var(--bird-color,#d09a5a));border:2px solid #fff1c4;border-bottom:4px solid #644324;border-radius:13px;box-shadow:0 3px #402817,inset 0 0 0 2px #fff5;color:#fffdf3;text-shadow:0 1px 2px #3b2732;padding:6px 2px}.card small{color:#fff4dc;font-weight:800}.card.active{background:linear-gradient(145deg,var(--bird-light,#ffe1b4),var(--bird-color,#d09a5a));border-color:#fff9d8;box-shadow:0 0 0 2px #ffd152,0 0 12px #ffbd3e,0 4px #ad7227;transform:translateY(-2px)}.card:disabled{filter:saturate(.5);opacity:.48}.card .bird-art{display:block;width:70px;height:62px;object-fit:contain;margin:auto;filter:drop-shadow(0 3px 1px #402d3c44);pointer-events:none}.qty{background:#2f2440;color:#fff;box-shadow:0 1px #fff6;font-size:11px;border-radius:9px;padding:2px 5px}.card.magic{background:linear-gradient(#e7caff,#7959b8);color:#fff}.card b{font-size:11px}.bottom{background:linear-gradient(#71401f,#512f20);padding:4px 12px 12px;border-bottom:3px solid #33261d}.info{color:#ffe2b7}.info b{color:#fff9dc;font-size:13px}.gold{background:linear-gradient(#ffe789,#f9ac37 55%,#e47922);border:2px solid #fff0a8;border-bottom:4px solid #a34d1d;color:#fff;text-shadow:0 2px #98451b}.footer{background:#3b281e;color:#d2ad83}.overlay{background:#092546db}.panel{background:linear-gradient(#fff5d5,#f7dfaa);border:5px solid #b87a3f;border-top-color:#f8c36b;border-bottom-color:#87512b;border-radius:22px;box-shadow:0 12px 40px #081c43aa,inset 0 0 0 2px #ffefc3}.panel h2{color:#633719;text-shadow:0 1px white;font-size:25px;font-weight:1000}.panel .go,.panel .buy{background:linear-gradient(#b5e66c,#65b52b 52%,#399223);border:2px solid #d7ef91;border-bottom:4px solid #28611b;color:#fff;text-shadow:0 2px #2d6b21;box-shadow:0 2px #ab965c66}.panel .bird-art{display:block;width:55px;height:49px;object-fit:contain;margin:auto}.panel .portrait .bird-art,.panel .detail>.bird-art{width:86px;height:78px}.world-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.panel .world-tile{position:relative;min-height:106px;border:2px solid #d0a361;border-bottom:4px solid #87512a;padding:0;border-radius:13px;background-image:linear-gradient(transparent 20%,#092c4dce 100%),var(--land);background-size:cover;background-position:center;overflow:hidden;text-align:left;display:flex;align-items:end;color:white}.chapter-badge{position:absolute;top:5px;left:6px;padding:3px 7px;border-radius:10px;background:#123b6a;color:#fff4d6;font-size:11px;box-shadow:0 1px #fff6}.world-caption{display:block;padding:8px;width:100%;text-shadow:0 1px 2px #132943}.world-caption b{display:block;font-size:12px}.world-caption small{display:block;color:#ffe6ac;font-size:10px}.journey{height:440px;border:3px solid #be864d;border-radius:17px;background-image:var(--land);background-size:cover;background-position:center;box-shadow:inset 0 0 18px #16385166}.map-veil{position:absolute;inset:0;background:linear-gradient(#143d5b33,#87c3d533 50%,#2c643e33)}.panel .route-node{border:3px solid #eee6d2!important;border-bottom:4px solid #7b7974!important;min-width:53px;min-height:38px;padding:3px 7px!important;background:linear-gradient(#a5adb4,#626f81)!important;color:white!important;text-shadow:0 2px #424c58;box-shadow:0 3px #342b2a80}.panel .route-node.open{background:linear-gradient(#69cafa,#126bb9)!important;color:#fff!important;border-color:#d0f4ff!important;border-bottom-color:#1b4a7a!important;text-shadow:0 2px #0d3f71}.route-node small{color:#ffe46d;text-shadow:0 1px #5c4924;white-space:nowrap}.panel .route-node.chosen{outline:3px solid #ffe56a;outline-offset:2px;box-shadow:0 0 14px #ffdc72}.panel .route-node.bossTile{border-color:#ffce60!important;background:linear-gradient(#d46e5f,#9d3943)!important}.panel .route-node:disabled{opacity:.9;filter:saturate(.35)}.stage-dock{margin-top:9px;display:flex;align-items:center;gap:8px;background:#ffedc5;border:1px solid #d5ad71;border-radius:12px;padding:8px;text-align:left;box-shadow:0 2px #cfa366}.stage-dock img{width:54px;height:54px;object-fit:cover;border-radius:8px}.stage-dock div{flex:1;min-width:0}.stage-dock b,.stage-dock small,.stage-dock span{display:block}.stage-dock b{font-size:14px}.stage-dock small{font-size:15px;color:#b7811c}.stage-dock span{font-size:9px;line-height:1.25}.stage-dock .buy{flex-shrink:0;padding:8px;font-weight:1000;white-space:nowrap;font-size:12px}
@media(max-width:410px){.top{min-height:59px;padding:5px 8px}.brand img{width:111px}.brand .edition{display:none}.wallet>span{padding:5px;font-size:10px}.wallet button{min-width:34px;padding:5px}.card{flex-basis:76px}.card .bird-art{width:59px;height:52px}.hud>div{padding:5px 6px}.panel{padding:11px}.panel .world-tile{min-height:90px}.journey{height:380px}.stage-dock img{width:42px;height:44px}.stage-dock .buy{padding:7px;font-size:11px}}
@media(orientation:landscape) and (max-height:600px){.top{min-height:0;padding:3px 12px}.brand img{width:96px}.brand .edition{display:none}.deck{padding:5px 8px}.card .bird-art{height:34px;width:43px}.tabs button{min-height:34px}.journey{height:380px}.arena canvas{width:min(100%,calc((100dvh - 70px)*1.6))}.card b,.card small{font-size:9px}}

/* Full-height portrait layout; world coordinates remain independent from display. */
.version{display:none;font-size:10px;font-weight:900;color:#fff4d5;background:#113961;border:1px solid #a0d5ff66;border-radius:8px;padding:4px 6px;white-space:nowrap}.top{background:linear-gradient(165deg,#248ad4,#174f95 80%);box-shadow:0 4px 12px #092a5b66;z-index:2}.top .wallet button{border-radius:13px}.hud>div{border:2px solid #bde5ffad;border-bottom:3px solid #13386c;border-radius:12px;background:linear-gradient(#2166ae,#133c77)}.hud .meter{background:#4e243c}.hud button{border-radius:12px}.deck .card{overflow:hidden}.card .bird-art{filter:drop-shadow(0 3px 2px #321b274a)}.deck .card.active{outline:2px solid #ffe571;outline-offset:0;box-shadow:0 0 12px #ffca43,0 3px 0 #6b361c}.tabs{background:linear-gradient(#a46132,#7b431e)}.deck{background:repeating-linear-gradient(4deg,#a06132 0px,#a06132 37px,#81451e 39px,#a06132 41px)}.bottom{background:linear-gradient(#8e4f29,#5c2d18)}
@media(orientation:portrait){body{background:#193d60}#game{height:100dvh;min-height:100dvh;display:flex;flex-direction:column;max-width:680px;padding-bottom:env(safe-area-inset-bottom,0px);overflow:hidden}.top{flex:0 0 auto;min-height:61px;padding:5px 8px;padding-top:max(5px,env(safe-area-inset-top,0px))}.brand img{width:clamp(92px,28vw,150px)}.brand .edition{display:none}.version{display:block}.wallet{gap:4px}.wallet>span{padding:5px 6px;font-size:10px}.wallet button{min-width:34px;min-height:37px;height:37px;padding:3px}.arena{flex:1 1 auto;min-height:160px;overflow:hidden;position:relative}.arena canvas{width:100%;height:100%;aspect-ratio:auto;display:block;object-fit:fill}.hud{top:6px;left:6px;right:6px;gap:4px}.hud>div{padding:5px 6px}.hud small{font-size:8px}.hud strong{font-size:16px}.hud button{min-width:32px;min-height:35px;padding:3px 7px}.boss{top:53px;left:18%;right:18%}.tabs{flex:0 0 auto;padding:5px 8px 2px}.tabs button{font-size:10px;padding:4px 8px;min-height:32px}.deck{flex:0 0 auto;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));padding:6px 8px 8px;gap:6px;overflow:visible}.card{min-width:0;min-height:57px;border-radius:10px;padding:2px 3px 3px;display:grid;grid-template-columns:1fr;align-content:center;justify-items:center;line-height:1.05}.card .bird-art{width:100%;height:clamp(29px,5.3dvh,47px);object-fit:contain}.card b{font-size:10px}.card small{font-size:9px}.card .qty{font-size:9px;padding:1px 4px}.card.magic .glyph{height:36px;line-height:36px}.bottom{flex:0 0 auto;padding:5px 9px 7px;gap:6px;min-height:49px}.info{font-size:10px}.info b{font-size:11px}.gold{min-height:40px;font-size:11px;padding:6px 10px}.footer{flex:0 0 auto;padding:3px 6px;font-size:9px;line-height:1.2}.world{bottom:8px;font-size:11px}.panel:has(.journey){max-width:480px;width:100%;max-height:95dvh}.journey{height:clamp(260px,53dvh,510px)}.stage-dock{margin-top:6px}}
@media(orientation:portrait) and (max-height:650px){.top{min-height:44px}.brand img{width:87px}.deck{gap:4px;padding:4px 6px}.card{min-height:45px}.card .bird-art{height:26px}.card b{font-size:9px}.card small{font-size:8px}.footer{display:none}.tabs button{min-height:29px}.bottom{min-height:38px}.gold{min-height:34px}}

/* 14.1 — illustrated game chrome; all controls remain semantic live elements. */
#game{isolation:isolate;background:#2c66ad;touch-action:manipulation}.top{border:0;background:linear-gradient(180deg,#1c7cdf,#2787d2 60%,#2064a1);box-shadow:inset 0 -2px 0 #8cc9ef75}.brand img{filter:drop-shadow(0 3px 1px #10243b80)}.wallet>span{background:linear-gradient(#254c88,#0b2c55);border:1px solid #c6e3ff;box-shadow:0 2px 0 #081a36;border-radius:12px;color:#fff8db;font-weight:1000}.top .wallet button,.hud button{background:linear-gradient(#ffe76e,#ffae1a 45%,#e4790e);border:2px solid #fff1ae;box-shadow:0 3px 0 #884312,inset 0 0 0 1px #bd6b19;color:#fffdf0;text-shadow:0 2px #854415}.hud>div{background:linear-gradient(#244c83,#13284d);border:2px solid #d1e5f7;border-bottom-color:#6b8bad;box-shadow:0 3px 0 #122940,inset 0 0 0 1px #516a91}.hud strong{color:#fff2ba;text-shadow:0 2px #0e2037;font-style:italic}.hud small{font-weight:1000;color:#fff}.meter-line{display:flex;align-items:center;gap:4px}.meter-line .meter{flex:1;min-width:0}.meter-line b{font-size:10px;color:#ffe99d}.hud .meter{border:1px solid #f6d59f;background:#401b30;box-shadow:inset 0 2px 3px #110b17}.hud .meter i{background:linear-gradient(#fff9b0 0%,#ffdf53 33%,#ffad1e 75%,#ed8a1b);box-shadow:0 0 4px #ffd45a}.room-track{position:absolute;top:60px;left:50%;transform:translateX(-50%);display:flex;align-items:center;pointer-events:none;filter:drop-shadow(0 2px 1px #17334d)}.room-track i{width:14px;height:14px;border:2px solid #fff3d8;border-radius:50%;background:#17315a}.room-track span{width:32px;height:4px;border:1px solid #eee4cd;background:#213c66}.room-track i:first-child,.room-track[data-room="2"] i:last-child{background:radial-gradient(circle at 35% 30%,#fffbc7,#ffb600 70%,#c67408)}.boss{top:79px}.world #world{background:linear-gradient(#bc783c,#703818);border:2px solid #edc18a;border-radius:9px;padding:5px 9px;font-weight:1000;font-style:italic;box-shadow:0 2px 0 #4b281c}.tabs,.deck,.bottom{background:linear-gradient(165deg,#bd7435,#7f431f 42%,#653217 100%);border-top:2px solid #e7a65f}.tabs button{background:linear-gradient(#30537c,#102747);border:2px solid #b6cde8;box-shadow:0 2px #482815;color:#fff5e4;font-weight:900}.tabs button.active{background:linear-gradient(#ffd84f,#e3a522 40%,#9b580b);border-color:#fff2b3;box-shadow:0 0 8px #ffdd6c,0 2px #653a17;color:#fff9d7}.deck .card{background:linear-gradient(150deg,var(--bird-light,#c6d6ff),var(--bird-color,#567bae) 55%,#242842);border:2px solid var(--bird-light,#dfd9fa);box-shadow:inset 0 0 0 1px #ffffffa6,0 3px 0 #44241a;min-width:0;color:white;text-shadow:0 1px 2px #172033}.deck .card b,.deck .card small{color:white}.deck .card .bird-art{filter:drop-shadow(0 2px 1px #1e152b77)}.deck .card.active{outline:2px solid #fff7b2;box-shadow:0 0 11px #ffcb39,inset 0 0 0 1px #fffbd0,0 3px 0 #563012}.deck .card.magic{background:linear-gradient(#a77bdc,#483968);border-color:#e1caff}.bottom{background:linear-gradient(#12415a,#09283b);border:3px solid #cf8d48;border-radius:13px;margin:3px 5px 4px;box-shadow:inset 0 0 0 1px #f5d09a;color:#fff4c4}.active-portrait{flex:0 0 48px;align-self:stretch;display:flex;align-items:center;justify-content:center}.active-portrait img{width:100%;max-height:53px;object-fit:contain;filter:drop-shadow(0 2px 2px #051e29)}.bottom .gold{border:2px solid #fff4aa;background:linear-gradient(#ffeb7a,#ffbe19 55%,#ed830a);color:#683508;box-shadow:0 3px 0 #98520c,inset 0 0 0 1px #ffc65b;font-weight:1000}.bottom .gold:disabled{opacity:.62}.footer{background:#193e25;color:#fff1cc}.panel:has(.journey){background:linear-gradient(#2b7dc5,#1f4b83);border:3px solid #c79559;color:#fff2cd}.panel:has(.journey) h2{color:#fff3cb;text-shadow:0 2px #713b1b;background:linear-gradient(#b8743b,#783a1b);border:2px solid #f1c581;border-radius:12px;padding:5px;margin:6px 5px}.panel:has(.journey) #desc{color:#fff3ce}.journey{background-position:center;background-size:100% 100%;border-color:#f2c582}.map-veil{background:linear-gradient(#16396416,#10233211)!important}.route-node{border:2px solid #f3f4ed!important;box-shadow:0 3px 0 #575a5f,0 0 0 1px #202c46!important;background:linear-gradient(#b6c0c7,#5c626e)!important;text-shadow:0 1px 2px #122036}.route-node.open{background:linear-gradient(#74d6fa,#1769c3)!important;box-shadow:0 3px 0 #18467d,0 0 0 1px #fff!important}.route-node.current,.route-node.chosen{outline:3px solid #ffdb45;box-shadow:0 0 18px #ffcf28!important}.route-node.bossTile{background:linear-gradient(#ed7760,#ab292f)!important;border-color:#ffdb6a!important}.route-node:disabled{opacity:1}.stage-dock{border:2px solid #ffe2ae!important;box-shadow:0 3px #75431f;background:linear-gradient(#fff7d9,#edc789)!important;color:#4c301b}.stage-dock .buy{background:linear-gradient(#b9ee47,#4ba300 70%,#327800);border:2px solid #e0fba0;box-shadow:0 3px #254f0e;text-shadow:0 1px #1d500b}.panel:has(.journey) #go{background:linear-gradient(#ffca54,#ce751c);border:2px solid #fff0b1;color:#fff4d6;box-shadow:0 2px #724017}.world-tile{border:2px solid #eecb8c}.panel:has(.world-grid) h2{color:#fff7d9;text-shadow:0 2px #663717}.panel:has(.world-grid){background:linear-gradient(#2c7bc0,#22486d)}
@media(orientation:portrait){.top{min-height:65px}.arena{min-height:160px}.room-track{top:57px}.boss{top:76px}.deck{grid-template-columns:repeat(4,minmax(0,1fr));gap:5px;padding:6px}.deck .card{min-height:59px;padding:3px}.deck .card .bird-art{height:clamp(30px,5.4dvh,49px)}.bottom{padding:5px;gap:5px;min-height:58px}.bottom .info{font-size:10px;line-height:1.3}.bottom .info b{font-size:11px}.footer{padding:2px;min-height:11px}.panel:has(.journey){max-height:96dvh}.journey{height:clamp(230px,57dvh,560px)}}
@media(orientation:portrait) and (max-height:650px){.top{min-height:44px}.deck .card{min-height:42px}.deck .card .bird-art{height:25px}.bottom{min-height:40px}.active-portrait{flex-basis:35px}.active-portrait img{max-height:34px}.room-track{top:51px}.boss{top:68px}.footer{display:none}}
/* 14.1: illustrated chapter panels, live path, readable cards and chrome */
.top{background:linear-gradient(180deg,#0c559b,#2594e7 48%,#13548e);border-bottom:2px solid #b3dfff}.hud>div{box-shadow:inset 0 1px 1px #e4f7ff99,0 3px 0 #172544aa}.hud .meter{box-shadow:inset 0 2px 3px #160c20}.tabs,.deck{background-color:#73421e;background-image:repeating-linear-gradient(2deg,#ffce7c10 0 2px,transparent 2px 13px),linear-gradient(180deg,#aa6637,#653719)}.deck .card{box-shadow:inset 0 1px 0 #fff9,0 3px 2px #291b1680}.deck .card.active{outline:2px solid #fff3a0;outline-offset:-2px;box-shadow:0 0 10px #ffde60,inset 0 0 0 1px #fff}.bottom{border-top:2px solid #f3bc67}.journey{background-size:cover!important;background-position:center!important}.route-node{font-variant-numeric:tabular-nums}.route-node.bossTile:disabled{filter:saturate(.1)}.stage-dock{border:2px solid #e6b064!important}.stage-dock .buy{box-shadow:inset 0 2px 0 #e4ffb2,0 3px 0 #315329}.world-tile{background-position:center 45%!important}.version{background:#0e3c71;color:#ffdf8d;border-color:#c3e6ff}
@media(prefers-reduced-motion:reduce){.route-node,.card{animation:none!important;transition:none!important}}

/* 14.1: stronger illustrated chrome, compact and readable across small screens. */
.hud>div{border:2px solid #bacde7;background:linear-gradient(155deg,#244b82,#102846 48%,#0c1c35);box-shadow:inset 0 1px 2px #ffffff88,0 3px 0 #0c1d35;}.hud .val{text-shadow:0 2px 1px #101a26}.hud .meter{border:1px solid #e5a65c;background:#321931;box-shadow:inset 0 2px 4px #0e0815}.tabs{border-top:3px solid #e7ae5e;border-bottom:2px solid #3c1d12}.deck .card{border:2px solid var(--bird-light,#c7b9eb);box-shadow:inset 0 0 0 1px #ffffff60,inset 0 -13px 20px #0b152b55,0 3px 0 #301b19}.deck .card.active{border-color:#fff1a4;box-shadow:0 0 0 2px #f6b62e,0 0 10px #ffdc73,0 3px 0 #533214}.deck .card .bird-art{filter:drop-shadow(0 2px 1px #17273a88)}.deck .card b{text-shadow:0 1px 2px #0b1625}.bottom{border:3px ridge #e8ad59;box-shadow:inset 0 2px 5px #112739,0 2px 0 #4b2815}.stage-dock{border:3px ridge #e9af62;box-shadow:0 3px 0 #694222}.route-node.chosen{outline:2px solid #fff4a0;outline-offset:2px}.panel h2{text-shadow:0 1px 0 #fff9dc}.footer{background:#21492e;color:#e6eccb}

/* Costume & Reward Craft 14.1: roster grouping and character-specific collectible cards. */
.panel:has(.hero-roster){background:radial-gradient(ellipse at 50% 0,#22697b,#103a46 44%,#092832);border:3px ridge #c3a468;color:#fff5d6;box-shadow:0 0 0 2px #234e53,0 12px 32px #001522aa;padding:12px;width:min(100%,520px)}
.panel:has(.hero-roster) h2{color:#ffe5a0;text-shadow:0 2px #16252b;font-size:21px;letter-spacing:.2px}.panel:has(.hero-roster) #desc{color:#c8e4de}.hero-roster{min-width:0}.hero-section{display:flex;align-items:center;justify-content:space-between;margin:10px 0 7px;padding:5px 11px;border:1px solid #4ba7aa;border-radius:8px;background:linear-gradient(#2a7883,#174a5b);font-size:11px;font-weight:900;letter-spacing:.7px;color:#dffaff}.hero-section b{color:#fff0a6}.hero-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:6px}.hero-card{position:relative;isolation:isolate;overflow:hidden;min-width:0;padding:0;border:2px solid var(--hero-light);border-radius:10px;background:radial-gradient(ellipse at 50% 20%,var(--hero-light),var(--hero) 55%,#182239);color:white;box-shadow:inset 0 0 0 1px #ffffff77,0 3px 0 #081d27;aspect-ratio: .88;display:flex;flex-direction:column;justify-content:flex-end}.hero-card.active{border-color:#ffe19b;box-shadow:0 0 0 1px #dba83d,0 0 8px #ffc43a66,inset 0 0 0 1px #fff7}.hero-card .bird-art{position:absolute;inset:0;width:100%;height:83%;object-fit:contain;filter:drop-shadow(0 2px 2px #18223677);z-index:-1;transform:scale(1.12)}.hero-title{display:block;padding:5px 2px 4px;background:linear-gradient(transparent,#102033e8 25%);text-shadow:0 1px 2px #000}.hero-title b{display:block;font-size:12px}.hero-title small{display:block;font-size:8px;line-height:1.3;white-space:normal}.hero-check,.hero-icon{position:absolute;top:3px;right:3px;border-radius:50%;height:19px;width:19px;background:#21454a;border:1px solid #c2e1d0;display:grid;place-items:center;font-size:13px;font-weight:900;color:white}.hero-card.active .hero-check{background:#4ca51b;border-color:#ffec98}.hero-icon{top:auto;bottom:28%;right:3px;background:#18364dc9;color:var(--hero-light);font-size:12px;width:18px;height:18px}.hero-hint{font-size:10px!important;color:#b8ded8!important;margin:9px 0!important}.hero-actions{display:flex;gap:8px;justify-content:stretch}.hero-actions button{flex:1;min-height:44px;font-size:11px}.hero-actions #playFlock{background:linear-gradient(#ffec7c,#ffbc21 60%,#df820a);border:2px solid #fff0a5;color:#6c390e;box-shadow:0 3px #8b4f0a}.hero-card:focus-visible{outline:3px solid white;outline-offset:2px}.deck .card .bird-art{object-fit:contain;transform:scale(1.13)}
@media(max-width:360px){.hero-grid{gap:4px}.hero-title b{font-size:10px}.hero-title small{font-size:7px}.hero-icon{display:none}.hero-check{width:16px;height:16px;font-size:11px}.panel:has(.hero-roster){padding:9px}}

/* 14.1: shared game dialog language; reward presentation is separate from reward accounting. */
.overlay[data-scene]:not([data-scene=""]) .panel{background:radial-gradient(ellipse at 50% 0,#267987,#133d51 46%,#0b2635);color:#fff1d0;border:3px solid #e0b267;box-shadow:0 0 0 2px #214d61,0 14px 40px #071524b3,inset 0 0 0 2px #ffffff20;padding:14px}
.overlay[data-scene]:not([data-scene=""]) h2{color:#ffe9a3;text-shadow:0 2px #102231;letter-spacing:.3px;margin:6px 0 8px}.overlay[data-scene]:not([data-scene=""]) #desc{color:#cde4e4}.overlay[data-scene]:not([data-scene=""]) .go{background:linear-gradient(#ffe99a,#ffbe25 65%,#db8209);border:2px solid #fff0bc;color:#683b12;box-shadow:0 3px #89511b;min-height:44px}.overlay[data-scene]:not([data-scene=""]) .item,.overlay[data-scene]:not([data-scene=""]) .receipt,.overlay[data-scene]:not([data-scene=""]) .mini,.overlay[data-scene]:not([data-scene=""]) .menu button{background:linear-gradient(155deg,#275d70,#183744);border:1px solid #72a3ad;color:#fff2d4;box-shadow:inset 0 1px #ffffff28}.overlay[data-scene]:not([data-scene=""]) .mini.active{border:2px solid #ffde7d;background:linear-gradient(#587c63,#244b4d)}.overlay[data-scene]:not([data-scene=""]) .item .txt,.overlay[data-scene]:not([data-scene=""]) .receipt{line-height:1.6}.overlay[data-scene]:not([data-scene=""]) .xp{background:#0a2534;border:1px solid #598594}.overlay[data-scene]:not([data-scene=""]) .xp i{background:linear-gradient(#c4f06a,#63a52b)}
.victory-banner{position:relative;overflow:hidden;border:1px solid #9bb2b0;border-radius:15px;background:radial-gradient(ellipse at 50% 95%,#f6c552aa,#255b7499 55%,#13364b);padding:8px 5px 10px;isolation:isolate}.victory-banner:before{content:'';position:absolute;inset:-90%;background:repeating-conic-gradient(from 12deg,#fff3ad16 0deg 9deg,transparent 10deg 24deg);z-index:-1;animation:reward-spin 26s linear infinite}.victory-flock{height:clamp(85px,17dvh,150px);display:flex;justify-content:center;align-items:center;overflow:hidden}.victory-flock img{width:36%;height:100%;object-fit:contain;filter:drop-shadow(0 5px 4px #10222b99);animation:hero-arrive .45s both}.victory-flock img:nth-child(2){width:42%;height:108%;margin:0 -10px;z-index:2;animation-delay:.07s}.victory-flock img:nth-child(3){animation-delay:.14s}.victory-banner>span{font-size:10px;font-weight:900;letter-spacing:.4px;color:#fff5bd}.loot-grid{display:flex;flex-wrap:wrap;gap:6px;margin:10px 0}.loot-grid>div{flex:1 1 65px;border:1px solid #c3a363;background:linear-gradient(#285c73,#172d3b);border-radius:11px;padding:7px 3px;text-align:center;min-width:0}.loot-grid span{display:block;color:#ffdb74;font-size:25px;line-height:1.1;text-shadow:0 2px #603c17}.loot-grid b{display:block;color:#ffe8a7;font-size:19px;font-variant-numeric:tabular-nums}.loot-grid small{display:block;font-size:10px;color:#d2e5de;line-height:1.3}.xp-loot{display:flex;gap:6px;justify-content:center;flex-wrap:wrap}.xp-loot span{flex:0 0 68px;text-align:center}.xp-loot img{display:block;width:48px;height:43px;object-fit:contain;margin:auto}.xp-loot small{font-size:9px;color:#d9ecca}.overlay[data-scene="victory"] .stars{color:#ffda57;text-shadow:0 2px #975615,0 0 16px #efbc4a;font-size:39px;animation:hero-arrive .5s both}.chest-art{width:128px;height:82px;margin:15px auto 10px;position:relative;display:grid;place-items:center;background:linear-gradient(#c18b42 0 38%,#79451e 39% 46%,#ad6a28 47% 100%);border:8px ridge #eac164;border-radius:24px 24px 12px 12px;font-size:30px;color:#fff0a9;box-shadow:0 6px 0 #48351c,0 0 32px #f5bf3b44}.chest-art:before,.chest-art:after{content:'';position:absolute;inset:-6px auto -6px 14px;width:9px;background:linear-gradient(90deg,#a77029,#ffe19b,#b47b34);border-radius:3px}.chest-art:after{left:auto;right:14px}.overlay[data-scene="chest"] #openChest{width:100%;margin:4px 0;min-height:44px}.overlay[data-scene="menu"] .menu button{min-height:52px;font-weight:800}.overlay[data-scene="menu"] .menu button:last-child{border-color:#f5d177;color:#ffdf87}
@keyframes reward-spin{to{transform:rotate(360deg)}}@keyframes hero-arrive{from{opacity:0;transform:translateY(8px) scale(.88)}to{opacity:1;transform:translateY(0) scale(1)}}@media(prefers-reduced-motion:reduce){.victory-banner:before,.victory-flock img,.overlay[data-scene="victory"] .stars{animation:none!important}}
/* A separate bonus slot keeps the eight-card battle grid unchanged. */
.tabs .swap{min-width:0;white-space:nowrap;background:linear-gradient(#b37b24,#725020);border-color:#ffe1a1;color:#fff4d1}
.tabs .swap.bonus-ready{display:flex;align-items:center;justify-content:center;gap:3px;padding:2px 6px;background:linear-gradient(#526f44,#254c3d);border-color:#c4ed96;line-height:1.05}
.swap.bonus-ready .bird-art{width:27px;height:25px;object-fit:contain;flex-shrink:0;pointer-events:none}.swap.bonus-ready b,.swap.bonus-ready small{display:block;text-align:left}.swap.bonus-ready small{font-size:8px;color:#d8f4ad}.swap.bonus-selected{outline:2px solid #ffe8a3;outline-offset:-2px;box-shadow:0 0 8px #f3dc79}
@media(max-width:360px){.tabs button{padding-inline:5px}.swap.bonus-ready .bird-art{width:21px;height:21px}}

/* 14.1: fitted outfits and reward motion, independent of accounting. */
.chest-stage{position:relative;width:min(100%,240px);margin:6px auto 8px;isolation:isolate}.treasure-drawing{width:100%;height:auto;display:block;overflow:visible;filter:drop-shadow(0 4px 5px #031a2677)}.chest-rays{opacity:0;transform-origin:130px 85px}.chest-lid{transform-origin:130px 79px}.chest-stage.opened .chest-lid{transform:translateY(-24px) rotate(-9deg);animation:chest-open .48s cubic-bezier(.16,1,.3,1) both}.chest-stage.opened .chest-rays{opacity:1;animation:chest-glow .9s ease-out both}.reward-reveal>div{animation:loot-arrive .36s ease-out both}.reward-reveal>div:nth-child(2){animation-delay:.07s}.reward-reveal>div:nth-child(3){animation-delay:.14s}.reward-reveal>div:nth-child(4){animation-delay:.21s}.wardrobe-preview{display:flex;align-items:center;gap:12px;justify-content:center;background:radial-gradient(ellipse,#437c8299,#142e40);border:1px solid #d1b46f;border-radius:13px;padding:5px 9px;margin:8px 0}.wardrobe-preview .bird-art{width:100px;height:92px;object-fit:contain;filter:drop-shadow(0 4px 3px #041b2a99)}.wardrobe-preview b,.wardrobe-preview small{display:block;text-align:left}.wardrobe-preview b{color:#ffe9a7;font-size:19px}.wardrobe-preview small{color:#d6e8dd;font-size:11px}.wardrobe-label{font-size:11px;font-weight:900;letter-spacing:.4px;margin:12px 0 3px;color:#ffe5a4}.wardrobe-grid .mini .bird-art{height:65px;width:100%;object-fit:contain}.wardrobe-grid .mini{min-width:0}.wardrobe-grid .mini small{display:block;font-size:10px}
@keyframes chest-open{from{transform:none}to{transform:translateY(-24px) rotate(-9deg)}}@keyframes chest-glow{from{opacity:0;transform:scale(.5)}to{opacity:1;transform:scale(1)}}@keyframes loot-arrive{from{opacity:0;transform:translateY(7px)}to{opacity:1;transform:none}}@media(prefers-reduced-motion:reduce){.chest-stage *,.reward-reveal>div{animation:none!important}}@media(max-width:360px){.wardrobe-grid .mini .bird-art{height:50px}.wardrobe-preview .bird-art{width:75px;height:68px}}
.wardrobe-grid .mini:disabled{opacity:.78}.wardrobe-grid .mini:disabled small{color:#e5d4ad}
.audio-setting .txt{min-width:0}.audio-setting label{display:block;font-size:12px}.audio-setting input{display:block;width:100%;margin:8px 0 0;accent-color:#d69b37;touch-action:pan-x}.audio-setting #volumeValue{float:right}
/* 14.1: gesture isolation and safe areas, without disabling accessible page zoom. */
#canvas{touch-action:none;-webkit-touch-callout:none;user-select:none;-webkit-user-select:none;overscroll-behavior:none}
#game{overscroll-behavior:contain} .overlay{overscroll-behavior:contain} .panel{overscroll-behavior:contain;touch-action:pan-y pinch-zoom} .panel input[type=range]{touch-action:pan-x}
button:focus-visible,input:focus-visible{outline:2px solid #fff3b0;outline-offset:2px}
@media(orientation:landscape) and (max-height:600px){#game{padding-left:env(safe-area-inset-left,0px);padding-right:env(safe-area-inset-right,0px);padding-bottom:env(safe-area-inset-bottom,0px)}}
</style></head><body><main id="game"><header class="top"><div class="brand"><h1>FEATHER FURY</h1><img id="brandLogo" src="data:image/webp;base64," alt="Feather Fury"><div class="edition">STABILITY UPDATE · 14.1</div><span class="version">14.1</span></div><div class="wallet"><span>◉ <b id="coins">180</b></span><span>❧ <b id="feathers">80</b></span><button id="campaign" aria-label="Bản đồ">⌘</button><button id="menu" aria-label="Menu">☰</button></div></header><div class="arena"><canvas id="canvas" width="960" height="600" aria-label="Kéo ná bắn chim"></canvas><div class="hud"><div><small id="stage">MÀN 001</small><strong id="score">0</strong></div><div style="flex:1"><small>PHÁ HỦY</small><div class="meter-line"><div class="meter"><i id="meter"></i></div><b id="meterValue">0%</b></div></div><div><small>CHIM</small><strong id="ammo">8</strong></div><div><small>ĐỊCH</small><strong id="targets">2</strong></div><button id="pause" aria-label="Tạm dừng">Ⅱ</button></div><div id="roomTrack" class="room-track" data-room="1" aria-hidden="true"><i></i><span></span><i></i></div><div class="boss" id="bossHUD" hidden><span id="bossName"></span><div class="meter"><i id="bossHP"></i></div></div><div class="world"><span id="world"></span><span id="camera"></span></div><div class="toast" id="toast" hidden></div></div><div class="tabs"><button id="birds" class="active">Đội hình</button><button id="magic">✦ Phép thuật</button><button id="swap" class="swap">＋ Thêm thẻ (1)</button></div><div id="deck" class="deck"></div><div class="bottom"><div id="activePortrait" class="active-portrait"></div><div id="info" class="info"></div><button id="power" class="gold" disabled>✦ Kỹ năng</button></div><div class="footer" id="footerStatus" role="status">14.1 · Offline · Không quảng cáo</div></main><div id="overlay" class="overlay" hidden><section class="panel" role="dialog" aria-modal="true" aria-labelledby="title"><div id="stars" class="stars"></div><h2 id="title"></h2><p id="desc"></p><div id="content"></div><button id="go" class="go">Tiếp tục</button></section></div><input id="import" type="file" accept="application/json,.json" hidden><script>const FF_ART={"anim-bird-0-0":"data:image/webp;base64,","anim-bird-0-1":"data:image/webp;base64,","anim-bird-0-2":"data:image/webp;base64,","anim-bird-0-3":"data:image/webp;base64,