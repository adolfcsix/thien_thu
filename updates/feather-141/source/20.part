function enemyArt(b){const i=b.type===3?3+Math.floor(level/10):b.type;const im=art('enemy-atlas-'+i),pose=enemyPose(b);g.save();g.translate(b.x,b.y);g.rotate(b.a);if(im){let k=b.r/46;g.drawImage(im,pose*192,0,192,192,-96*k,-112*k,192*k,192*k)}else{ell(0,0,b.r,b.r,'#83af54');ell(-b.r*.35,-b.r*.2,b.r*.23,b.r*.25,'#fff5d9');ell(b.r*.35,-b.r*.2,b.r*.23,b.r*.25,'#fff5d9');ell(0,b.r*.28,b.r*.4,b.r*.25,'#c1d889')}
if(b.type===3&&shield()){g.beginPath();g.arc(0,0,b.r*1.4,0,6.283);g.strokeStyle='#b5efffd9';g.lineWidth=3;g.stroke()}if(b.guard&&shield())ell(0,-b.r-14,4,4,'#a2efff');if(b.type===1){rr(-b.r,-b.r-15,b.r*2,4,2,'#172b41');rr(-b.r,-b.r-15,b.r*2*clamp(b.hp/b.max,0,1),4,2,'#f4dc76')}g.restore()}

function material(b){let m=M[b.mat],x=-b.w/2,y=-b.h/2;g.save();g.translate(b.x,b.y);g.rotate(b.a);rr(x+2,y+3,b.w,b.h,3,'#26323c30');rr(x,y,b.w,b.h,2,gradient(x,y,x+b.w,y+b.h,[[0,m[3]],[.5,m[2]],[1,m[4]]]),m[4],1.8);line(x+3,y+3,x+b.w-3,y+3,m[3],2);let texture=art('paint-'+b.mat)||art(b.mat);if(texture){g.save();if(b.h>b.w*1.5){g.rotate(Math.PI/2);g.drawImage(texture,-b.h/2,-b.w/2,b.h,b.w)}else g.drawImage(texture,x,y,b.w,b.h);g.restore()}if(b.kind==='tnt'){rr(x+2,-10,b.w-4,20,3,'#fff0c2');g.font='900 13px system-ui';g.textAlign='center';g.fillStyle='#9a4636';g.fillText('TNT',0,5)}else if(b.mat==='ice'){poly([[x+3,y+3],[x+b.w-3,y+3],[x+3,y+b.h-3]],'#ffffff79');line(x+4,y+b.h-4,x+b.w-4,y+4,'#ffffff99',1.7)}else{line(x+5,y+b.h-5,x+b.w-5,y+b.h-5,m[4],1.8);if(b.mat==='wood'){if(b.w>b.h)line(x+7,0,x+b.w-7,0,'#85562e66',1.6);else line(0,y+7,0,y+b.h-7,'#85562e66',1.6)}ell(x+5,y+5,1.7,1.7,m[4])}if(b.kind==='block'&&b.w>=90&&b.h<=20&&b.mat==='wood'&&b.hp>b.max*.55){let roof=art('paint-roof');let exposed=!bodies.some(q=>q!==b&&!q.dead&&q.kind==='block'&&Math.abs(q.x-b.x)<b.w*.55&&q.y<b.y&&b.y-q.y<75);if(roof&&exposed){let rw=b.w*1.06,rh=rw*.32;g.drawImage(roof,-rw/2,y-rh*.82,rw,rh)}}if(b.kind==='block'&&b.mat==='wood'&&b.h>=60&&b.w<35){for(let yy of [y+9,y+b.h-9]){rr(x+2,yy-4,b.w-4,8,2,'#a7a2a0','#5f5143',1);ell(x+5,yy,1.7,1.7,'#eee9d2');ell(x+b.w-5,yy,1.7,1.7,'#eee9d2')}}if(b.kind==='block'&&b.mat==='wood'&&b.w>=70&&b.h<=20){for(let xx of [x+8,x+b.w-8]){rr(xx-3,y+1,6,b.h-2,1,'#5f3e27');for(let k=0;k<3;k++)line(xx-3,y+3+k*(b.h-6)/2,xx+3,y+1+k*(b.h-6)/2,'#edc684',1.7)}}if(b.kind==='block'&&b.mat==='stone'&&b.w>=70&&b.h<=24){for(let xx=x+22;xx<x+b.w-6;xx+=26){line(xx,y+2,xx-2,y+b.h-2,'#4d5365a0',1.5);line(xx+2,y+2,xx,y+b.h-2,'#d9e0e69a',1)}}if(b.hp<b.max*.72){line(x+b.w*.1,y+b.h*.1,x+b.w*.56,y+b.h*.44,m[4],2);line(x+b.w*.56,y+b.h*.44,x+b.w*.34,y+b.h*.65,m[4],2);line(x+b.w*.34,y+b.h*.65,x+b.w*.88,y+b.h*.95,m[4],2)}g.restore()}
function sling(front){let q=drag||{x:SX,y:SY};let im=art('sling-painted');if(im){if(!front){g.drawImage(im,SX-53,SY-35,106,F-SY+35);if(state==='aim')line(SX+32,SY-15,q.x,q.y,'#5d2622',8)}else if(state==='aim')line(SX-32,SY-15,q.x-4,q.y+3,'#a83f32',8);return}if(!front){line(SX-8,F,SX-5,SY+53,'#62432f',23);line(SX-5,SY+53,SX+32,SY-21,'#815535',21);line(SX+30,SY-18,SX-1,SY+45,'#d6a66f',5);if(state==='aim')line(SX+32,SY-15,q.x,q.y,'#604039',8)}else{line(SX-7,SY+53,SX-32,SY-21,'#8d5c38',21);line(SX-33,SY-18,SX-13,SY+43,'#e0ad73',5);if(state==='aim')line(SX-33,SY-15,q.x-4,q.y+3,'#87533a',7)}}
// 12.6: illustration layers are deliberately non-colliding and follow rigid-body transforms.
function detailImage(name,x,y,w,h){const im=art(name);if(im)g.drawImage(im,x,y,w,h)}
function foregroundArt(){let k=Math.floor(level/10);if(viewHeight<=H)return;let y=viewHeight-viewOffset;let h=Math.min(74,Math.max(30,(y-F)*.55));g.save();g.beginPath();g.rect(0,F+12,W,Math.max(0,y-F-12));g.clip();g.fillStyle=gradient(0,y-h*1.8,0,y,[[0,'#152d3c00'],[1,'#12283888']]);g.fillRect(0,y-h*1.8,W,h*1.8);if([0,1,5,9].includes(k)){detailImage('detail-flowers',-8,y-h,250,h+8);detailImage('detail-rocks',W-340,y-h,355,h+8)}else{for(let j=0;j<8;j++){let x=j*140-30,base=y+6,hh=22+(j*17)%35;poly([[x,base],[x+17,base-hh],[x+57,base-hh-5],[x+95,base]],k===2?'#ccefff':k===4?'#b77c56':'#53667c','#203a4a',2);line(x+17,base-hh,x+57,base-hh-5,'#ffffff66',2)}}g.restore()}
function buildingDetail(b){if(b.kind!=='block'||b.hp<b.max*.42)return;let x=-b.w/2,y=-b.h/2;g.save();g.translate(b.x,b.y);g.rotate(b.a);if(b.mat==='wood'&&b.h>=60&&b.w<=30){for(let j=0;j<3;j++){let yy=y+11+j*(b.h-22)/2;line(x+3,yy,x+b.w-3,yy+1,'#4e2d20a0',2);line(x+3,yy+2,x+b.w-3,yy+3,'#ffdba999',1.4)}line(x+3,y+5,x+3,y+b.h-5,'#ffdf9c99',2)}if(b.w>=90&&b.h<=22){let exposed=!bodies.some(q=>q!==b&&!q.dead&&q.kind==='block'&&Math.abs(q.x-b.x)<b.w*.5&&q.y<b.y&&b.y-q.y<75);if(exposed){let k=Math.floor(level/10);if([0,1,5,9].includes(k)){detailImage('detail-banner',b.w*.21,y-46,52,32);detailImage('detail-lantern',-b.w*.5,y+2,13,20)}else if(k===2||k===3){poly([[x+6,y],[x+12,y-13],[x+18,y],[x+24,y-9],[x+31,y]],'#c8efff','#5aa4c2',1.3)}else{poly([[b.w*.26,y],[b.w*.26,y-27],[b.w*.48,y-21],[b.w*.38,y-13],[b.w*.48,y-6],[b.w*.26,y-9]],k===8?'#bb3444':'#754b9b','#f6d18a',1.3)}}}g.restore()}
// 12.7: finish on existing surfaces, without filling the openings of towers.
function architectureFinish(b){if(b.kind!=='block'||b.hp<b.max*.45)return;let x=-b.w/2,y=-b.h/2,k=Math.floor(level/10);g.save();g.translate(b.x,b.y);g.rotate(b.a);
if(b.w>=70&&b.h<=24){let metal=b.mat==='iron',stone=b.mat==='stone';line(x+4,y+3,-x-4,y+3,'#fff1c6aa',1.5);for(let u=x+12;u<-x-6;u+=26){if(b.mat==='wood'||metal){rr(u-3,y+2,6,b.h-4,1,metal?'#879eae':'#94613d','#392b2b88',.7);ell(u,0,1.6,1.6,'#ffe3b5')}else if(stone){line(u,y+2,u-2,-y-2,'#3e4b6266',1.5)}}
let above=bodies.some(q=>q!==b&&!q.dead&&q.kind==='block'&&Math.abs(q.x-b.x)<b.w*.48&&q.y<b.y&&b.y-q.y<80);if(!above&&b.mat!=='wood'&&b.mat!=='ice'){for(let u=x+6;u<-x-6;u+=22){rr(u,y-7,13,9,2,metal?'#8ca4b2':'#9da6b0','#415464',1);line(u+2,y-6,u+11,y-6,'#e1e9ed',1.4)}}}
if(b.h>=60&&b.w<=35){if(b.mat==='ice'){for(let j=0;j<3;j++){let yy=y+14+j*(b.h-28)/2;poly([[0,yy-6],[b.w*.28,yy],[0,yy+6],[-b.w*.28,yy]],'#d9ffff75','#ffffff99',.8)}}else{for(let yy of [y+7,-y-7]){rr(x+1,yy-4,b.w-2,8,2,b.mat==='wood'?'#ae895a':'#8296a8','#3e4854',.8);ell(x+4,yy,1.6,1.6,'#ffebc4');ell(-x-4,yy,1.6,1.6,'#ffebc4')}if(b.mat==='wood'&&b.w>=19){line(x+4,y+15,-x-4,-y-15,'#714329',3);line(x+5,y+15,-x-3,-y-15,'#edb76b',1)}}}g.restore()}
function regionalArchitecture(b){
 if(b.kind!=='block'||b.dead||b.hp<b.max*.25)return;
 const k=Math.floor(level/10),x=-b.w/2,y=-b.h/2;
 const colors=['#c99139','#ba753d','#9bd9e7','#70b9db','#d9a36a','#edad51','#88b6a3','#779d76','#b6b8cd','#dfbc68'];
 const col=colors[k];g.save();g.translate(b.x,b.y);g.rotate(b.a);
 if(b.w>=90&&b.h<=24){
  // Engraved fascia contained within the collision block, not a false platform.
  g.save();g.beginPath();g.rect(x+2,y+2,b.w-4,b.h-4);g.clip();
  line(x+3,y+4,-x-3,y+4,col,2);line(x+4,-y-4,-x-4,-y-4,'#342c375e',2);
  for(let u=x+13;u<-x-6;u+=19){
   if(k===2||k===3||k===9)poly([[u,0],[u+4,-4],[u+8,0],[u+4,4]],col,'#f6ffff99',.7);
   else if(k===8||k===4) {rr(u,-3,7,6,1,col,'#3d4653',.7);ell(u+3.5,0,1,1,'#fff1c4')}
   else {line(u,-3,u+5,3,col,1.8);line(u+5,-3,u,3,col,1.2)}
  }g.restore();
 }
 if(b.h>=62&&b.w<=30){
  // Small caps and inlays follow the individual pillars as they fall.
  g.save();g.beginPath();g.rect(x+1,y+1,b.w-2,b.h-2);g.clip();
  for(let yy of [y+12,-y-12]){line(x+2,yy,-x-2,yy,col,3);line(x+2,yy+3,-x-2,yy+3,'#3a354b99',1)}
  if(b.mat==='stone'||b.mat==='iron'){for(let yy=y+24;yy<-y-12;yy+=19){line(x+2,yy,-x-2,yy,'#26384685',1.3);ell(0,yy-7,2,2,col)}}
  else if(b.mat==='ice'){poly([[0,y+18],[x+4,0],[0,-y-18],[-x-4,0]],'#e8ffff45',col,.7)}
  g.restore();
 }g.restore();
}
function skillIllustration(){if(reduced)return;for(let e of skillArt){let age=time-e.start;if(age<0||age>.72)continue;let t=age/.72,col=pal(e.i)[1],r=22+120*t;g.save();g.translate(e.x,e.y);g.rotate(e.a);g.globalAlpha=(1-t)*.85;switch(e.i){
case 0:for(let j=0;j<7;j++)line(-15-t*90,j*7-21,25+t*34,j*3-9,col,3);break;
case 1:for(let j of [-1,0,1]){line(0,0,r,Math.sin(j*.6)*r,col,4);ell(r,Math.sin(j*.6)*r,5,5,'#f3fcff')}break;
case 2:case 7:for(let j=0;j<12;j++){let a=j*Math.PI/6;poly([[Math.cos(a)*r*.3,Math.sin(a)*r*.3],[Math.cos(a-.08)*r,Math.sin(a-.08)*r],[Math.cos(a+.08)*r,Math.sin(a+.08)*r]],col)}break;
case 3:g.beginPath();g.arc(0,0,r*.7,.2,5.2);g.strokeStyle=col;g.lineWidth=6;g.stroke();poly([[-r*.72,-7],[-r*.42,-20],[-r*.42,7]],col);break;
case 4:g.rotate(-e.a);for(let j=-2;j<=2;j++)line(j*11,-r,j*8,r*.4,col,4);break;
case 5:for(let j=0;j<6;j++){let a=j*Math.PI/3;ell(Math.cos(a)*r*.5,Math.sin(a)*r*.5,7,7,col)}break;
case 6:case 9:for(let j=0;j<3;j++){g.beginPath();g.ellipse(0,0,r*(.4+j*.22),r*.32,0,-1.1,1.1);g.strokeStyle=col;g.lineWidth=3;g.stroke()}break;
case 8:for(let j=0;j<7;j++){let a=j*.898;let x=Math.cos(a)*r*.65,y=Math.sin(a)*r*.65;ringVisual(x,y,10+j%3*5,col);ell(x-3,y-4,2,2,'#fff')}break;
case 10:for(let j=-1;j<=1;j++)line(-r*.8,j*13-r*.2,r*.8,j*13+r*.2,col,5);break;
case 11:for(let j=-2;j<=2;j++)line(0,0,r,j*r*.2,col,1.8);break;}g.restore()}}
function bossInsignia(b){if(b.type!==3)return;let k=Math.floor(level/10),colors=['#69dbff','#a5ffeb','#ffc56f','#a78dff','#ffbf55','#ff9a72','#96dfff','#cbb5ff','#f589db','#a6f4ff'],col=colors[k];g.save();g.translate(b.x,b.y);g.rotate(b.a);let r=b.r;const cap=-r*1.3;switch(k%5){case 0:for(let d of [-1,1])poly([[d*r*.75,cap+6],[d*r*1.15,cap-5],[d*r*.9,cap-16],[d*r*.46,cap+1]],'#d7e7ed','#38516e',2);break;case 1:for(let d of [-1,1])poly([[d*r*.55,cap],[d*r*.87,cap-23],[d*r*1.13,cap-8],[d*r*.85,cap+4]],col,'#40668c',2);break;case 2:for(let d of [-1,1])poly([[d*r*.72,cap+7],[d*r*1.36,cap-11],[d*r*1.18,cap+9]],'#e1b76a','#744b2c',2);break;case 3:for(let d of [-1,1]){ell(d*r*.92,cap-2,8,9,'#392a64');ell(d*r*.92,cap-2,4,5,col)}break;case 4:for(let d of [-1,1])poly([[d*r*.62,cap+7],[d*r*1.34,cap-20],[d*r*.98,cap-1],[d*r*1.22,cap-3],[d*r*.74,cap+17]],col,'#8e5e20',1.5);break}if(k>=5){rr(-r*.65,r*.42,r*1.3,8,3,'#b17b38','#4e3526',1.8);poly([[0,r*.35],[7,r*.55],[0,r*.77],[-7,r*.55]],col,'#fff0b9',1)}g.restore()}
function flightDecor(){if(reduced||!shot||shot.dead||state!=='flight')return;let b=shot,i=b.type,col=pal(i)[1],v=Math.hypot(b.vx,b.vy);if(v<70)return;let a=Math.atan2(b.vy,b.vx);g.save();g.translate(b.x,b.y);g.rotate(a);g.globalAlpha=used?.76:.37;const len=Math.min(105,18+v*.065);let glow=gradient(-len,0,0,0,[[0,col+'00'],[1,col]]);g.fillStyle=glow;g.beginPath();g.moveTo(-len,0);g.quadraticCurveTo(-len*.3,-11,0,-b.r*.47);g.lineTo(0,b.r*.47);g.quadraticCurveTo(-len*.3,11,-len,0);g.fill();if(used){for(let j=0;j<5;j++){let x=-14-j*13,y=Math.sin(time*16+j)*8;ell(x,y,Math.max(1,4-j*.5),1.7,col)}}g.restore()}
function impactDecor(){if(reduced)return;for(let r of rings){let a=clamp(r.t/.65,0,1);if(a>.72)continue;let size=Math.max(5,r.r*(.12+.88*a)),alpha=(1-a)*.2;g.save();g.globalAlpha=alpha;let q=g.createRadialGradient(r.x,r.y,0,r.x,r.y,size);q.addColorStop(0,'#fff8cc');q.addColorStop(.4,r.col);q.addColorStop(1,'#ffffff00');ell(r.x,r.y,size,size,q);g.globalAlpha=(1-a)*.55;for(let j=0;j<10;j++){let theta=j*Math.PI/5+r.x*.013,inner=size*.72,outer=size*(1.02+.13*Math.sin(j*7));line(r.x+Math.cos(theta)*inner,r.y+Math.sin(theta)*inner,r.x+Math.cos(theta)*outer,r.y+Math.sin(theta)*outer,r.col,Math.max(1,3*(1-a)))}g.restore()}}
function render(){resizeView();g.save();g.translate(0,viewOffset);background();livingWater(Math.floor(level/10));ambient(Math.floor(level/10));g.save();g.translate(480,300);g.scale(cam.z,cam.z);g.translate(-cam.x,-cam.y);if(shake>.2&&!reduced)g.translate(rnd(-shake,shake),rnd(-shake,shake));for(let w of winds){rr(w.x,w.y,w.w,w.h,12,'#d9ffff25');for(let i=0;i<10;i++){let x=w.x+12+i*43%(w.w-24),y=w.y+((i*47-time*100)%w.h+w.h)%w.h;line(x,y,x+10,y-30,'#eaffffb0',2.8)}}for(let pair of portals)pair.forEach((p,i)=>{let col=i?'#8de7fc':'#cba5ff';ell(p.x,p.y,35,35,col+'55');g.beginPath();g.arc(p.x,p.y,28,0,6.283);g.strokeStyle=col;g.lineWidth=5;g.stroke()});for(let b of bodies)if(!b.dead&&b.kind==='land'){if(b.h>60&&viewHeight>H){let top=b.y-b.h/2,extra=Math.max(b.h,viewHeight-viewOffset-top+100);terrain({...b,h:extra,y:top+extra/2})}else terrain(b)}sling(false);for(let p of trail){g.globalAlpha=clamp(p.t,0,.65);ell(p.x,p.y,4,3,p.col)}g.globalAlpha=1;for(let b of [...bodies.filter(b=>b.kind!=='bird'&&b.kind!=='enemy'),...bodies.filter(b=>b.kind==='bird'||b.kind==='enemy')]){if(b.dead||b.kind==='land')continue;if(b.kind==='bird')bird(b.x,b.y,b.r,b.type,Math.atan2(b.vy,b.vx)*.32,true,b);else if(b.kind==='enemy'){enemyArt(b);bossInsignia(b)}else if(['bomb','meteor','magic'].includes(b.kind)){let col=b.kind==='bomb'?'#695171':b.kind==='meteor'?'#e7873b':'#eec45a';if(b.kind==='meteor')for(let j=5;j>0;j--)ell(b.x,b.y-j*20,Math.max(3,b.r-j*4),17,'#ffb14a55');ell(b.x,b.y,b.r,b.r,gradient(b.x-b.r,b.y-b.r,b.x+b.r,b.y+b.r,[[0,'#fff1c0'],[.4,col],[1,'#5d4b56']]))}else{material(b);buildingDetail(b);architectureFinish(b);regionalArchitecture(b)}}flightDecor();if(state==='aim'&&canShoot()){let q=drag||{x:SX,y:SY};if(drag){let vx=(SX-q.x)*9.5,vy=(SY-q.y)*9.5,x=q.x,y=q.y;for(let i=1;i<=29;i++){for(let j=0;j<12;j++){vy+=G*DT;vx*=.9995;let v=Math.hypot(vx,vy);if(v>1500){vx*=1500/v;vy*=1500/v}x+=vx*DT;y+=vy*DT}if(x>W||y>F)break;ell(x,y,Math.max(2,5-i*.12),Math.max(2,5-i*.12),'#fffbe6dd')}}bird(q.x,q.y,18,sel)}drawEffects();skillIllustration();impactDecor();sling(true);for(let p of fx){let a=clamp(p.life/p.max,0,1);g.globalAlpha=p.kind==='smoke'?a*.35:a;if(p.kind==='smoke')ell(p.x,p.y,p.r*(1.5-a*.4),p.r,p.col);else if(p.kind==='spark')line(p.x,p.y,p.x-p.vx*.018,p.y-p.vy*.018,p.col,Math.max(1,p.r*.7));else{g.save();g.translate(p.x,p.y);g.rotate(p.a);rr(-p.r/2,-p.r/2,p.r*1.4,p.r,1,p.col);g.restore()}}g.globalAlpha=1;for(let r of rings){let a=r.t/.65;g.globalAlpha=clamp(1-a,0,1);g.beginPath();g.arc(r.x,r.y,Math.max(1,r.r*(.12+.88*a)),0,6.283);g.strokeStyle=r.col;g.lineWidth=6*(1-a)+1;g.stroke()}g.globalAlpha=1;for(let n of labels){g.globalAlpha=clamp(n.t*2,0,1);g.font=`900 ${n.s.length>9?18:25}px system-ui`;g.textAlign='center';g.lineWidth=4;g.strokeStyle='#3b4b43';g.strokeText(n.s,n.x,n.y);g.fillStyle=n.col;g.fillText(n.s,n.x,n.y)}g.globalAlpha=1;g.restore();foregroundArt();if((spell>=0||rescue)&&state==='aim'){g.fillStyle='#896cc524';g.fillRect(0,0,W,H);g.setLineDash([9,8]);g.strokeStyle=rescue?'#ffe4a0':S[spell][2];g.lineWidth=3;g.strokeRect(270,65,680,F-35);g.setLineDash([])}if(intro>0){g.fillStyle=`rgba(16,37,44,${intro/.5*.65})`;g.fillRect(0,0,W,H);g.globalAlpha=clamp(intro/.35,0,1);g.fillStyle='#fff0c6';g.textAlign='center';g.font='900 32px system-ui';g.fillText(bossMode>=0?BN[Math.floor(level/10)]:`MÀN ${level+1} · CHẶNG ${room+1}`,480,285);g.font='bold 15px system-ui';g.fillText(bossMode>=0?BM[bossMode]:BIOMES[Math.floor(level/10)][0],480,318);g.globalAlpha=1}g.restore()}
function update(dt){skillArt=skillArt.filter(e=>time-e.start<.72);let d=dt*(slow>0?.5:1);for(let p of fx){p.x+=p.vx*d;p.y+=p.vy*d;p.vy+=(p.kind==='smoke'?-15:310)*d;p.a+=d*5;p.life-=d}fx=fx.filter(p=>p.life>0);for(let r of rings)r.t+=d;rings=rings.filter(r=>r.t<.65);for(let n of labels){n.y-=dt*30;n.t-=dt}labels=labels.filter(n=>n.t>0);for(let p of trail)p.t-=dt;trail=trail.filter(p=>p.t>0);if(shot&&!shot.dead&&state==='flight'&&flight-trailAt>.035){trail.push({x:shot.x,y:shot.y,t:.7,col:pal(shot.type)[1]});trailAt=flight}shake*=Math.exp(-dt*10);slow=Math.max(0,slow-dt);focus=Math.max(0,focus-dt);intro=Math.max(0,intro-dt);let x=480,y=300,z=1;if(sv.dynamic&&!reduced&&state==='aim'&&spell<0&&!rescue&&viewHeight>H){if(drag){x=cam.x;y=cam.y;z=cam.z}else{const targets=bodies.filter(b=>!b.dead&&b.kind!=='land'&&b.kind!=='bird');let right=Math.max(650,...targets.map(b=>b.x+(Math.abs(Math.cos(b.a))*b.w+Math.abs(Math.sin(b.a))*b.h)/2+48)),top=Math.min(SY-65,...targets.map(b=>b.y-(Math.abs(Math.sin(b.a))*b.w+Math.abs(Math.cos(b.a))*b.h)/2-55));z=clamp(Math.min(W/right,H/Math.max(1,H-top)),1,1.38);x=W/(2*z);y=H-H/(2*z)}}if(sv.dynamic&&!reduced&&state==='flight'){if(focus>0){x=ix;y=iy-40;z=1.32}else if(shot&&!shot.dead){x=shot.x+105;y=shot.y+45;z=1.15}}let a=1-Math.exp(-dt*6.8);cam.z+=(z-cam.z)*a;let hx=W/(2*cam.z),hy=H/(2*cam.z);cam.x=clamp(cam.x+(x-cam.x)*a,hx,W-hx);cam.y=clamp(cam.y+(y-cam.y)*a,hy,H-hy);let text=sv.dynamic?(slow>0?'SLOW MOTION':focus>0?'IMPACT CAM':state==='flight'?'FOLLOW CAM':cam.z>1.04?'CẬN CẢNH':''):'WIDE VIEW';if($('camera').textContent!==text)$('camera').textContent=text}
let lastPaint=-Infinity;
function suspendGame(){cancelPull();stopAudio();last=acc=0;if(pendingSave)persist();if(!paused&&state!=='end')show('TẠM DỪNG','Bạn đã chuyển sang ứng dụng hoặc tab khác.','','Chơi tiếp',resume)}
function recoverFrame(error){if(frameFault)return;frameFault=true;console.error('Feather Fury: frame recovery',error);cancelPull();stopAudio();last=acc=0;state='end';show('KHÔI PHỤC CHẶNG','Game gặp lỗi hiển thị hoặc mô phỏng. Tiến trình đã lưu không thay đổi. Hãy khôi phục chặng.','','Khôi phục chặng',()=>{if(!contextLost)retry()})}
canvas.addEventListener('contextlost',e=>{e.preventDefault();contextLost=true;recoverFrame('Canvas context lost');$('desc').textContent='Bộ vẽ tạm thời không khả dụng. Nếu trình duyệt không khôi phục, hãy mở lại game từ bản lưu.';$('go').disabled=true});
canvas.addEventListener('contextrestored',()=>{contextLost=false;markSize();last=acc=0;$('go').disabled=false;if(frameFault)$('desc').textContent='Bộ vẽ đã khôi phục. Nhấn Khôi phục chặng để chơi lại.';});
function loop(now){try{if(frameFault||contextLost)return;let dt=last?Math.min(.04,(now-last)/1000):0;last=now;if(!document.hidden){if(!paused){time+=dt;if(state==='flight'){acc+=dt*(slow>0?.45:1);let i=0;while(acc>=DT&&i++<9&&state==='flight'&&!paused){acc-=DT;step()}}else acc=0;update(dt);const moving=state==='flight'||drag||intro>0||fx.length||rings.length||labels.length||Math.abs(cam.z-1)>.001;const interval=reduced&&!moving?1000/15:1000/60;if(dirty||now-lastPaint>=interval-1){render();lastPaint=now}}else if(dirty){render();lastPaint=now}if(dirty){hud();dirty=false}}}catch(error){recoverFrame(error)}finally{requestAnimationFrame(loop)}}
function pos(e){let r=canvas.getBoundingClientRect();if(!r.width||!r.height)return{x:SX,y:SY};return{x:((e.clientX-r.left)*W/r.width-480)/cam.z+cam.x,y:((e.clientY-r.top)*viewHeight/r.height-viewOffset-300)/cam.z+cam.y}}function pull(p){let dx=Math.min(5,p.x-SX),dy=p.y-SY,l=Math.hypot(dx,dy),k=l>110?110/l:1;drag={x:SX+dx*k,y:SY+dy*k}}
canvas.addEventListener('pointerdown',e=>{e.preventDefault();if(paused||intro>.2||!e.isPrimary||e.button!==0)return;if(state==='flight'){skill();return}if(state!=='aim')return;let p=pos(e);if(rescue){rescueCast(p);return}if(spell>=0){cast(p);return}if(pid!==null||!canShoot()||Math.hypot(p.x-SX,p.y-SY)>118)return;pid=e.pointerId;try{canvas.setPointerCapture(pid)}catch(e){}pull(p)});canvas.addEventListener('pointermove',e=>{if(drag&&pid===e.pointerId)pull(pos(e))});canvas.addEventListener('pointerup',e=>{if(pid===e.pointerId){pull(pos(e));pid=null;launch()}});for(let ev of ['pointercancel','lostpointercapture'])canvas.addEventListener(ev,e=>{if(pid===e.pointerId)cancelPull()});document.addEventListener('visibilitychange',()=>{if(document.hidden)suspendGame();else{syncAudio();cancelPull();last=acc=0;markSize();if(pendingSave)persist()}});document.addEventListener('keydown',e=>{if(paused){if(e.key==='Tab'){let all=[...$('overlay').querySelectorAll('button:not(:disabled),input:not(:disabled):not([type=hidden]),select:not(:disabled),textarea:not(:disabled),a[href]')],i=all.indexOf(document.activeElement);if((e.shiftKey&&i<=0)||(!e.shiftKey&&i===all.length-1)){e.preventDefault();all[e.shiftKey?all.length-1:0]?.focus()}}return}if(e.target instanceof HTMLButtonElement&&['Space','Enter'].includes(e.code))return;if(e.code==='Space'&&state==='flight'){e.preventDefault();skill()}if(/^[1-8]$/.test(e.key)&&state==='aim'&&!rescue&&stock[activeFlock[+e.key-1]]){cancelPull();bonusSelected=false;sel=activeFlock[+e.key-1];tab=0;spell=-1;deck()}if(e.key==='Escape'&&state!=='end')menu()});
// Play surface only: suppress Safari pinch/double-tap zoom and browser context menu.
if(typeof canvas.addEventListener==='function'){
 for(const ev of ['gesturestart','gesturechange','gestureend','dblclick','contextmenu'])canvas.addEventListener(ev,e=>e.preventDefault(),{passive:false});
 canvas.addEventListener('touchstart',e=>{if(e.touches.length>1){cancelPull();e.preventDefault()}},{passive:false});
 canvas.addEventListener('touchmove',e=>{if(e.touches.length>1){cancelPull();e.preventDefault()}},{passive:false});
}
for(let i=0;i<B.length;i++)art('paint-bird-'+i+'-'+sv.birds[i].skin);for(let m of Object.keys(M))art(m);art(sceneName(Math.floor(sv.open/10)));start(sv.open);if(!storage){$('footerStatus').textContent='14.1 · Chưa lưu được — hãy xuất sao lưu'}if(loadNote){$('toast').textContent=loadNote;$('toast').hidden=false;setTimeout(()=>$('toast').hidden=true,4000)}requestAnimationFrame(loop);
// Test-only entry point: not enabled during ordinary play.
})();</script></body></html>
