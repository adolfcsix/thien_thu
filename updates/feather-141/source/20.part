let viewHeight=H,viewOffset=0;
let sizeDirty=true;const markSize=()=>{sizeDirty=true;dirty=true};
function cancelPull(){const id=pid;const wasDragging=!!drag;pid=null;drag=null;if(id!==null){try{if(canvas.hasPointerCapture?.(id))canvas.releasePointerCapture(id)}catch(e){}}if(id!==null||wasDragging)dirty=true}
if(typeof ResizeObserver!=='undefined'){new ResizeObserver(()=>{cancelPull();markSize()}).observe(canvas)}
if(typeof window.addEventListener==='function'){window.addEventListener('resize',()=>{cancelPull();markSize()});window.addEventListener('blur',cancelPull);window.addEventListener('pagehide',suspendGame);window.addEventListener('pageshow',()=>{last=acc=0;markSize();syncAudio()})}
function resizeView(){if(typeof canvas.getBoundingClientRect!=='function'||!sizeDirty&&typeof ResizeObserver!=='undefined')return;let rect=canvas.getBoundingClientRect();if(rect.width<1||rect.height<1)return;sizeDirty=false;let h=matchMedia('(orientation: portrait)').matches?Math.max(H,Math.min(2200,Math.round(W*rect.height/rect.width))):H;if(canvas.height!==h){cancelPull();canvas.height=h;viewHeight=h;viewOffset=Math.round((h-H)*.83);dirty=true}}
function cover(im,x,y,w,h){let f=Math.max(w/im.naturalWidth,h/im.naturalHeight),dw=im.naturalWidth*f,dh=im.naturalHeight*f;g.drawImage(im,x+(w-dw)/2,y+(h-dh)/2,dw,dh)}
function background(){let k=Math.floor(level/10),plate=art(sceneName(k));g.save();g.beginPath();g.rect(0,-viewOffset,W,viewHeight);g.clip();if(plate)cover(plate,0,-viewOffset,W,viewHeight);else{g.fillStyle=gradient(0,-viewOffset,0,H,[[0,theme()[1]],[1,theme()[2]]]);g.fillRect(0,-viewOffset,W,viewHeight);g.drawImage(scenery(k),0,0)}g.restore()}

