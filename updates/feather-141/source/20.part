const canShoot=()=>bonusSelected?hasBonus()&&sel===bonusBird:stock[sel]>0;
const hasShots=()=>ammo()>0||hasBonus();
function choose(){if(bonusSelected&&hasBonus()){sel=bonusBird;return}bonusSelected=false;if(stock[sel]>0)return;let i=stock.findIndex(x=>x>0);if(i>=0)sel=i;else if(hasBonus()){sel=bonusBird;bonusSelected=true}else sel=activeFlock[0]}
function selectBonus(){if(paused||state!=='aim'||!hasBonus()||rescue)return false;bonusSelected=true;sel=bonusBird;tab=0;spell=-1;cancelPull();deck();dirty=true;return true}
function revealBonus(){if(reduced)return;const el=$('swap');el.animate?.([{transform:'perspective(500px) rotateY(-85deg) scale(.88)',filter:'brightness(1.8)'},{transform:'perspective(500px) rotateY(12deg) scale(1.06)',filter:'brightness(1.3)',offset:.7},{transform:'none',filter:'none'}],{duration:420,easing:'cubic-bezier(.2,.7,.3,1)'});}
function drawBonus(){if(state!=='aim'||!bonusLeft||hasBonus()||rescue)return false;bonusLeft=0;bonusBird=Math.floor(Math.random()*B.length);close();selectBonus();revealBonus();cue('bonus');hud();return true}
function start(l){if(contextLost)return;level=clamp(l,0,99);room=0;score=meter=0;activeFlock=[...sv.flock];stock=B.map((_,i)=>activeFlock.includes(i)?1:0);for(let i=0;i<Math.floor(level/20);i++)stock[activeFlock[i]]++;sel=activeFlock[0];runXP=Array(B.length).fill(0);runShots=runKills=0;assisted=false;setup()}
function setup(fresh=true){if(contextLost)return;if(frameFault)canvas.width=W;frameFault=false;cancelPull();stopAudio();trimArt();skillArt=[];effects=[];bodies=[];fx=[];rings=[];labels=[];trail=[];queue=[];hits.clear();shot=drag=null;pid=null;spell=-1;rescue=false;tab=0;used=false;state='aim';flight=quiet=clear=acc=slow=shake=focus=sim=0;intro=reduced?0:.5;cam={x:480,y:300,z:1};let d=generate(level,room);winds=d.winds;portals=d.portals;bossMode=d.mode;d.a.forEach(o=>make(o.x,o.y,o.w,o.h,o));if(fresh){bonusLeft=1;bonusBird=-1;bonusSelected=false}choose();if(fresh){cp={score,meter,stock:[...stock],sel,bonusLeft,bonusBird,bonusSelected,runXP:[...runXP],runShots,runKills,assisted}}close();hud();deck();dirty=true}
function retry(){if(contextLost)return;if(!cp){start(level);return}({score,meter,sel,bonusLeft,bonusBird,bonusSelected,runShots,runKills,assisted}=cp);stock=[...cp.stock];runXP=[...cp.runXP];setup(false)}
function hud(){$('coins').textContent=sv.coins;$('feathers').textContent=sv.feathers;$('stage').textContent=`MÀN ${String(level+1).padStart(3,'0')} · ${room+1}/2`;$('score').textContent=score.toLocaleString('vi-VN');$('ammo').textContent=ammo();$('targets').textContent=count();$('meter').style.width=clamp(meter/4500*100,0,100)+'%';$('meterValue').textContent=Math.floor(clamp(meter/4500*100,0,100))+'%';$('roomTrack').dataset.room=room+1;$('world').textContent=theme()[0];let b=boss();$('bossHUD').hidden=!b;if(b){$('bossName').textContent=BN[Math.floor(level/10)]+' · '+(shield()?'KHIÊN ĐANG BẬT':BM[bossMode]);$('bossHP').style.width=clamp(b.hp/b.max*100,0,100)+'%'}}
function deck(){let d=$('deck'),sc=d.scrollLeft;$('birds').classList.toggle('active',tab===0);$('magic').classList.toggle('active',tab===1);d.innerHTML=tab===0?activeFlock.map(i=>{let b=B[i];return `<button class="card ${!bonusSelected&&sel===i?'active':''}" style="--bird-color:${b[2]};--bird-light:${b[3]}" data-i="${i}" ${state!=='aim'||!stock[i]?'disabled':''}><span class="qty">${stock[i]}</span>${portrait(i)}<b>${b[0]}</b><small>Lv.${sv.birds[i].lv}</small></button>`}).join(''):S.map((s,i)=>`<button class="card magic ${spell===i?'active':''}" data-i="${i}" ${state!=='aim'||!sv.spells[i]?'disabled':''}><span class="qty">${sv.spells[i]}</span><div class="glyph" style="color:${s[2]}">${s[1]}</div><b>${s[0]}</b><small>Phép thuật</small></button>`).join('');d.scrollLeft=sc;d.querySelectorAll('[data-i]').forEach(e=>e.onclick=()=>{if(paused||state!=='aim'||rescue)return;cancelPull();let i=+e.dataset.i;if(tab===0){bonusSelected=false;sel=i;spell=-1}else spell=spell===i?-1:i;deck();dirty=true});let i=state==='flight'&&shot?shot.type:sel;$('info').innerHTML=rescue?'<b>Hỗ trợ vượt chặng</b>Chạm trực tiếp mục tiêu hoặc quân hộ vệ. Màn này tối đa 1 sao.':spell>=0?`<b>${S[spell][0]}</b>Chạm công trình để thi triển.`:tab===1&&state==='aim'?'<b>Kho phép thuật</b>Không mất lượt bắn.':`<b>${B[i][0]} · ${B[i][1]}</b>${state==='flight'?(used?'Đã dùng kỹ năng.':([8,9,11].includes(i)?'Đến gần công trình rồi kích hoạt. Không mất kỹ năng nếu chưa có mục tiêu.':'Chạm sân chơi hoặc Space.')):(bonusSelected?'Thẻ miễn phí · không trừ lượt bắn. ': '')+TIPS[i]+' Kéo ná rồi thả.'}`;$('activePortrait').innerHTML=portrait(i);$('power').textContent=rescue?'Hủy cứu trợ':spell>=0?'Hủy chọn':state==='aim'&&!hasShots()?'Hỗ trợ':'✦ Kỹ năng';$('power').disabled=!rescue&&!(state==='aim'&&!hasShots())&&spell<0&&(state!=='flight'||used||!shot||shot.dead);const extra=$('swap');extra.disabled=state!=='aim'||rescue||(!hasBonus()&&!bonusLeft);extra.classList.toggle('bonus-ready',hasBonus());extra.classList.toggle('bonus-selected',hasBonus()&&bonusSelected&&tab===0);extra.innerHTML=hasBonus()?`${portrait(bonusBird)}<span><b>${B[bonusBird][0]}</b><small>MIỄN PHÍ</small></span>`:bonusLeft?'＋ Thêm thẻ (1)':'Đã dùng thẻ';extra.setAttribute?.('aria-label',hasBonus()?`Chọn thẻ miễn phí ${B[bonusBird][0]}`:bonusLeft?'Thêm thẻ miễn phí':'Đã dùng thẻ miễn phí');extra.setAttribute?.('aria-pressed',String(hasBonus()&&bonusSelected&&tab===0))}
function setTab(v){if(state!=='aim'||paused)return;if(rescue){outOfAmmo();return}tab=v;spell=-1;cancelPull();deck();dirty=true}$('birds').onclick=()=>setTab(0);$('magic').onclick=()=>setTab(1);$('swap').onclick=()=>{if(paused)return;if(hasBonus())selectBonus();else drawBonus()};
function show(t,d,s,btn,fn){modalRevision++;if(!paused)modalReturn=document.activeElement;paused=true;cancelPull();action=fn;$('overlay').dataset.scene=({ 'CHIẾN THẮNG!':'victory','BOSS ĐÃ BỊ HẠ!':'victory','GRAND CHAMPION!':'victory','CHẶNG HOÀN THÀNH':'room','RƯƠNG THƯỞNG':'chest','ĐÃ MỞ RƯƠNG':'chest','FLOCK WORKSHOP':'workshop','NHIỆM VỤ':'quests','MAGIC MARKET':'shop','CÀI ĐẶT':'settings','SKY ISLANDS':'menu'})[t]||'';$('title').textContent=t;$('desc').textContent=d;$('stars').textContent=s;$('go').textContent=btn;$('content').innerHTML='';$('overlay').hidden=false;$('game').inert=true;$('go').focus();dirty=true}
function close(){modalRevision++;paused=false;action=null;$('overlay').hidden=true;$('game').inert=false;last=0;acc=0;if(modalReturn?.isConnected)modalReturn.focus();modalReturn=null;dirty=true}$('go').onclick=()=>{if(paused)action?.()};
function resume(){if(state==='end')start(level);else if(state==='aim'&&!hasShots()&&!rescue&&spell<0)outOfAmmo();else close();deck()}
function menu(){show('SKY ISLANDS','100 màn · 200 chặng · Chơi offline','','Trở về',resume);let items=[['Chiến dịch',map],['Đội hình',workshop],['Chọn 8 chim ra trận',roster],['Nhiệm vụ',quests],['Cửa hàng',shop],['Rương thưởng',chest],['Cài đặt',settings],['Chơi lại chặng',retry],['Màn mới nhất',()=>start(sv.open)]];$('content').innerHTML=`<div class="menu">${items.map((x,i)=>`<button data-m="${i}">${x[0]}</button>`).join('')}</div>`;$('content').querySelectorAll('[data-m]').forEach(e=>e.onclick=items[+e.dataset.m][1])}$('menu').onclick=menu;$('campaign').onclick=map;$('pause').onclick=()=>{if(state!=='end')show('TẠM DỪNG','Lượt chơi hiện tại được giữ nguyên.','','Chơi tiếp',resume)};
function map(){show('SKY ODYSSEY',`${sv.stars.filter(x=>x>0).length}/100 màn · ★ ${sv.stars.reduce((a,b)=>a+b,0)}/300`,'','Quay lại',menu);$('content').innerHTML=`<div class="world-grid">${BIOMES.map((z,i)=>{let done=sv.stars.slice(i*10,i*10+10).filter(n=>n>0).length;return `<button class="world-tile" data-z="${i}" style="--land:url('${artURL(sceneName(i))}')"><span class="chapter-badge">${String(i+1).padStart(2,'0')}</span><span class="world-caption"><b>${z[0]}</b><small>${done}/10 màn · ★ ${sv.stars.slice(i*10,i*10+10).reduce((a,b)=>a+b,0)}/30</small></span></button>`}).join('')}</div>`;$('content').querySelectorAll('[data-z]').forEach(e=>e.onclick=()=>chapter(+e.dataset.z))}
function chapter(i,selected=Math.max(i*10,Math.min(i*10+9,sv.open))){let z=BIOMES[i];show(z[0],`VÙNG ${i+1}/10 · MÀN ${i*10+1}–${i*10+10}`,'','Thế giới',map);const pts=[[25,91],[60,82],[75,72],[45,63],[23,54],[48,45],[76,36],[65,27],[32,18],[49,8]],curve='M25 91 Q42 94 60 82 T75 72 Q69 65 45 63 T23 54 Q24 47 48 45 T76 36 Q83 30 65 27 T32 18 Q25 11 49 8';let locked=selected>sv.open;let node=pts.map(([x,y],j)=>{let n=i*10+j,b=j===9;return `<button class="route-node ${n<=sv.open?'open':''} ${n===sv.open?'current':''} ${n===selected?'chosen':''} ${b?'bossTile':''}" style="left:${x}%;top:${y}%" data-l="${n}" ${n>sv.open?'disabled':''} aria-label="Màn ${n+1}" aria-pressed="${n===selected}"><strong>${b?'♛ ':''}${n>sv.open&&!b?'🔒 ':''}${n+1}</strong><small>${'★'.repeat(sv.stars[n])+'☆'.repeat(3-sv.stars[n])}</small></button>`}).join('');$('content').innerHTML=`<div class="journey " style="--land:url('${artURL(mapScene(i))}');--sky:${z[1]}"><div class="map-veil"></div><svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><path d="${curve}" fill="none" stroke="#614638" stroke-width="7.5" stroke-linecap="round"/><path d="${curve}" fill="none" stroke="#f5c56e" stroke-width="5.8" stroke-linecap="round"/><path d="${curve}" fill="none" stroke="#fff3cb" stroke-width=".8" stroke-dasharray="2 2" stroke-linecap="round"/></svg>${node}</div><div class="stage-dock"><img src="${artURL(sceneName(i))}" alt=""><div><b>Màn ${selected+1}${selected%10===9?' · BOSS':''}</b><small>${'★'.repeat(sv.stars[selected])+'☆'.repeat(3-sv.stars[selected])}</small><span>${locked?'Chưa mở khóa':sv.claimed[selected]?'Chơi lại · 15 vàng':(selected%10===9?'230–290':'130–190')+' vàng · 30–50 lông vũ'}</span></div><button id="playStage" class="buy" ${locked?'disabled':''}>Chiến đấu ▶</button></div>`;$('content').querySelectorAll('[data-l]').forEach(e=>e.onclick=()=>{let n=+e.dataset.l;if(n<=sv.open)chapter(i,n)});$('playStage').onclick=()=>{if(!locked&&selected<=sv.open)start(selected)}}

function roster(){
 let picked=[...sv.flock];const icons=['✹','❄','✷','↶','↓','✦','≋','⬟','◉','♫','◈','⌁'];
 const card=i=>{let b=B[i],on=picked.includes(i);return `<button class="hero-card ${on?'active':''}" style="--hero:${b[2]};--hero-light:${b[3]}" data-r="${i}" aria-pressed="${on}" aria-label="${b[0]} · ${b[1]}" title="${TIPS[i]}">${portrait(i)}<span class="hero-check">${on?'✓':'+'}</span><span class="hero-title"><b>${b[0]}</b><small>Lv.${sv.birds[i].lv} · ${b[1]}</small></span><span class="hero-icon">${icons[i]}</span></button>`};
 const paint=()=>{show('ĐỘI HÌNH ANH HÙNG',`Chọn đúng 8 chim ra trận · ${picked.length}/8`,'','Quay lại',menu);$('content').innerHTML=`<section class="hero-roster"><div class="hero-section"><span>ĐỘI HÌNH</span><b>${picked.length}/8</b></div><div class="hero-grid">${picked.map(card).join('')}</div><div class="hero-section"><span>DỰ BỊ</span><b>${B.length-picked.length}</b></div><div class="hero-grid">${B.map((_,i)=>i).filter(i=>!picked.includes(i)).map(card).join('')}</div><p class="hero-hint">Bỏ chọn một chim để thay thế. Mỗi chim có kỹ năng riêng.</p><div class="hero-actions"><button id="saveFlock" class="buy" ${picked.length!==8?'disabled':''}>Lưu đội hình</button><button id="playFlock" class="buy" ${picked.length!==8?'disabled':''}>Lưu & chơi lại màn</button></div></section>`;
 $('content').querySelectorAll('[data-r]').forEach(e=>e.onclick=()=>{let i=+e.dataset.r;if(picked.includes(i))picked=picked.filter(x=>x!==i);else if(picked.length<8)picked.push(i);paint();$('content').querySelectorAll('[data-r]').forEach(n=>{if(+n.dataset.r===i)n.focus()})});
 $('saveFlock').onclick=()=>{if(picked.length===8){sv.flock=[...picked];persist();menu()}};$('playFlock').onclick=()=>{if(picked.length===8){sv.flock=[...picked];persist();start(level)}}};paint()}

function workshop(){let i=work,b=sv.birds[i],ok=b.lv<10&&b.xp>=cost(i)&&sv.coins>=cost(i)&&sv.feathers>=fcost(i);show('FLOCK WORKSHOP',`◉ ${sv.coins} · ❧ ${sv.feathers}`,'','Quay lại',menu);$('content').innerHTML=`<div class="grid">${B.map((v,j)=>`<button class="mini ${i===j?'active':''}" data-b="${j}">${portrait(j)}${v[0]}<small>Lv.${sv.birds[j].lv}</small></button>`).join('')}</div><div class="wardrobe-preview">${portrait(i)}<div><b>${B[i][0]}</b><small>${K[b.skin][0]} · Lv.${b.lv}</small></div></div><div class="receipt"><b>${B[i][0]} · Lv.${b.lv}</b><br><b>${B[i][1]}</b> · ${TIPS[i]}<br>Sát thương ${Math.round(powerOf(i)*100)}% · ${b.lv===10?'Cấp tối đa':b.xp+'/'+cost(i)+' XP'}<div class="xp"><i style="width:${b.lv===10?100:clamp(b.xp/cost(i)*100,0,100)}%"></i></div><button class="buy" id="upgrade" ${ok?'':'disabled'}>Nâng cấp · ◉ ${cost(i)} · ❧ ${fcost(i)}</button></div><div class="wardrobe-label">TRANG PHỤC · ${b.owned.filter(Boolean).length}/4</div><div class="grid wardrobe-grid">${K.map((k,j)=>`<button class="mini ${b.skin===j?'active':''}" data-s="${j}" ${!b.owned[j]&&(sv.coins<k[1]||b.lv<k[2])?'disabled':''}>${portrait(i,j)}${k[0]}<small>${b.skin===j?'Đang dùng':b.owned[j]?'Trang bị':b.lv<k[2]?'Lv.'+k[2]:'◉ '+k[1]}</small></button>`).join('')}</div>`;$('content').querySelectorAll('[data-b]').forEach(e=>e.onclick=()=>{work=+e.dataset.b;workshop()});$('upgrade').onclick=()=>{if(b.lv>=10||b.xp<cost(i)||sv.coins<cost(i)||sv.feathers<fcost(i))return;b.xp-=cost(i);sv.coins-=cost(i);sv.feathers-=fcost(i);b.lv++;persist();hud();deck();workshop()};$('content').querySelectorAll('[data-s]').forEach(e=>e.onclick=()=>{let j=+e.dataset.s,k=K[j];if(!b.owned[j]){if(sv.coins<k[1]||b.lv<k[2])return;sv.coins-=k[1];b.owned[j]=true}b.skin=j;persist();hud();deck();workshop()})}
const Q=[['Chiến thắng đầu tiên',()=>sv.wins,1,100,30],['Xạ thủ',()=>sv.shots,12,160,50],['Thợ săn Goblin',()=>sv.kills,25,220,70],['Bậc thầy đội hình',()=>sv.birds.filter(b=>b.lv>=2).length,3,300,100],['Nhà thám hiểm',()=>sv.stars.filter(x=>x>0).length,20,500,150],['Đại vô địch',()=>sv.stars.filter(x=>x>0).length,100,1500,500]];
function quests(){show('NHIỆM VỤ','Thưởng một lần cho mỗi mốc.','','Quay lại',menu);$('content').innerHTML=Q.map((q,i)=>`<div class="item"><div class="txt"><b>${q[0]}</b>${Math.min(q[1](),q[2])}/${q[2]} · ◉ ${q[3]} · ❧ ${q[4]}<div class="xp"><i style="width:${clamp(q[1]()/q[2]*100,0,100)}%"></i></div></div><button class="buy" data-q="${i}" ${sv.quests[i]||q[1]()<q[2]?'disabled':''}>${sv.quests[i]?'Đã nhận':'Nhận'}</button></div>`).join('');$('content').querySelectorAll('[data-q]').forEach(e=>e.onclick=()=>{let i=+e.dataset.q,q=Q[i];if(sv.quests[i]||q[1]()<q[2])return;sv.quests[i]=true;sv.coins+=q[3];sv.feathers+=q[4];sv.keys++;persist();hud();quests()})}
function shop(){show('MAGIC MARKET',`◉ ${sv.coins} vàng`,'','Quay lại',menu);$('content').innerHTML=S.map((s,i)=>`<div class="item"><div class="txt"><b>${s[1]} ${s[0]}</b>${s[4]} · Kho ${sv.spells[i]}</div><button class="buy" data-buy="${i}" ${sv.coins<s[3]||sv.spells[i]>=99?'disabled':''}>◉ ${s[3]}</button></div>`).join('');$('content').querySelectorAll('[data-buy]').forEach(e=>e.onclick=()=>{let i=+e.dataset.buy;if(sv.coins<S[i][3]||sv.spells[i]>=99)return;sv.coins-=S[i][3];sv.spells[i]++;persist();hud();deck();shop()})}
// Pure presentation: receipt values are derived from the committed transaction.
function chestArt(open=false){return `<div class="chest-stage ${open?'opened':''}" aria-hidden="true"><svg viewBox="0 0 260 165" class="treasure-drawing"><defs><linearGradient id="chestWood" x2=".2" y2="1"><stop stop-color="#eeae53"/><stop offset="1" stop-color="#713719"/></linearGradient><linearGradient id="chestGold" x2="0" y2="1"><stop stop-color="#fff3aa"/><stop offset=".48" stop-color="#e4a331"/><stop offset="1" stop-color="#9b5c20"/></linearGradient></defs><ellipse cx="130" cy="150" rx="91" ry="8" fill="#041e29" opacity=".55"/><g class="chest-rays"><path d="M130 12L143 67L189 21L173 77L244 68L183 96L225 128L159 116L130 152L101 116L35 128L77 96L16 68L87 77L71 21L117 67Z" fill="#ffdc70" opacity=".55"/></g><path d="M39 79L221 79L211 139Q207 146 197 146H63Q53 146 49 139Z" fill="url(#chestWood)" stroke="#633719" stroke-width="5"/><path d="M47 96H214M53 119H209" stroke="#66391e" stroke-width="3"/><path d="M65 81L73 144M195 81L187 144M45 136H215" stroke="url(#chestGold)" stroke-width="12"/><g class="chest-lid"><path d="M39 79V62Q39 32 72 30H188Q221 32 221 62V79Z" fill="url(#chestWood)" stroke="#633719" stroke-width="5"/><path d="M68 34L65 77M192 34L195 77M39 77H221" stroke="url(#chestGold)" stroke-width="12"/><path d="M84 43Q130 34 176 43" fill="none" stroke="#ffd68b" stroke-width="4" stroke-linecap="round"/><rect x="116" y="66" width="28" height="28" rx="7" fill="url(#chestGold)" stroke="#82501d" stroke-width="3"/><circle cx="130" cy="77" r="5" fill="#5e351c"/><path d="M130 79V85" stroke="#5e351c" stroke-width="4"/></g><path d="M130 103L140 114L130 126L120 114Z" fill="#89e0cf" stroke="#fbe3a1" stroke-width="3"/></svg></div>`}
function chestLoot(i,a,b,gift,received=false){return `<div class="loot-grid reward-reveal"><div><span>◉</span><b>${received?'+':''}${a}</b><small>Vàng</small></div><div><span>❧</span><b>${received?'+':''}${b}</b><small>Lông vũ</small></div><div><span>${S[i][1]}</span><b>+${gift}</b><small>${S[i][0]}${gift===0?' · Kho đầy':''}</small></div></div>`}
function chest(){let i=sv.chests%5,a=80+i*15,b=30+i*5,gift=sv.spells[i]<99?1:0,committed=false;show('RƯƠNG THƯỞNG',`${sv.keys} chìa khóa · Phần thưởng biết trước`,'','Quay lại',menu);$('content').innerHTML=chestArt()+chestLoot(i,a,b,gift)+`<button class="buy" id="openChest" ${!sv.keys?'disabled':''}>Mở rương · 1 chìa khóa</button>`;$('openChest').onclick=()=>{if(committed||!sv.keys)return;committed=true;$('openChest').disabled=true;sv.keys--;sv.chests++;sv.coins+=a;sv.feathers+=b;gift=sv.spells[i]<99?1:0;sv.spells[i]+=gift;persist();hud();deck();show('ĐÃ MỞ RƯƠNG','Phần thưởng đã được cộng vào kho.','✦','Quay lại',chest);$('content').innerHTML=chestArt(true)+chestLoot(i,a,b,gift,true);cue('reward')}}
function settings(){show('CÀI ĐẶT',storage?'Lưu trên thiết bị. Sao lưu JSON để chuyển máy.':'Không thể ghi bộ nhớ cục bộ. Hãy xuất sao lưu JSON.','','Quay lại',menu);$('content').innerHTML=`<div class="item"><div class="txt">Âm thanh</div><button id="sound" class="buy">${sv.muted?'Bật':'Tắt'}</button></div><div class="item audio-setting"><div class="txt"><label for="volume">Âm lượng hiệu ứng <b id="volumeValue">${sv.volume}%</b></label><input id="volume" type="range" min="0" max="100" step="5" value="${sv.volume}" aria-label="Âm lượng hiệu ứng"></div><button id="audioPreview" class="buy" ${sv.muted?'disabled':''}>Nghe thử</button></div><div class="item"><div class="txt">Camera động</div><button id="dynamic" class="buy">${sv.dynamic?'Bật':'Tắt'}</button></div><div class="menu"><button id="exportSave">Xuất sao lưu</button><button id="importSave">Nhập sao lưu</button></div><p>Nhập sao lưu thay thế tiến trình hiện tại và bắt đầu lại màn mới nhất.</p>`;$('sound').onclick=()=>{sv.muted=!sv.muted;persist();if(sv.muted)stopAudio();else{unlockAudio();cue('bonus')}settings()};$('volume').oninput=e=>{sv.volume=Number(e.target.value);$('volumeValue').textContent=sv.volume+'%';syncAudio()};$('volume').onchange=()=>persist();$('audioPreview').onclick=()=>{unlockAudio();cue('reward')};$('dynamic').onclick=()=>{sv.dynamic=!sv.dynamic;persist();settings()};$('exportSave').onclick=()=>{let blob=new Blob([JSON.stringify(sv,null,2)],{type:'application/json'}),u=URL.createObjectURL(blob),a=document.createElement('a');a.href=u;a.download='feather-fury-save.json';a.click();setTimeout(()=>URL.revokeObjectURL(u),1000)};$('importSave').onclick=()=>$('import').click()}
$('import').onchange=async e=>{let file=e.target.files[0];e.target.value='';if(!file)return;const revision=++modalRevision;try{if(file.size>100000)throw Error('Tệp quá lớn');let raw=JSON.parse(await file.text());if(revision!==modalRevision)return;if(![10,11].includes(raw.schema))throw Error('Cần sao lưu schema 10 hoặc 11');let next=normalize(raw);show('KHÔI PHỤC SAO LƯU','Tiến trình hiện tại sẽ bị thay thế.','','Quay lại',settings);let b=document.createElement('button');b.className='buy';b.textContent='Xác nhận khôi phục';b.onclick=()=>{sv=next;persist();start(sv.open)};$('content').append(b)}catch(e){if(revision!==modalRevision)return;show('KHÔNG THỂ NHẬP','Tệp sao lưu không hợp lệ. Tiến trình hiện tại không thay đổi.','','Quay lại',settings)}};
// Original procedural audio. No network, music samples or external assets.
const AUDIO_RECIPES={
 launch:[['sweep',640,180,.13,.13],['noise',1700,400,.09,.08]],
 wood:[['noise',1350,300,.10,.13],['triangle',185,72,.09,.09]],
 ice:[['noise',6200,1800,.12,.10],['sine',1900,1100,.16,.07],['sine',2700,1900,.09,.04,.025]],
 stone:[['noise',680,130,.14,.12],['triangle',135,55,.13,.10]],
 iron:[['triangle',880,390,.18,.08],['sine',1410,940,.20,.055],['noise',2600,650,.07,.08]],
 enemy:[['triangle',510,220,.15,.10],['sine',770,340,.13,.05,.035]],
 boss:[['sweep',180,55,.28,.12],['noise',900,180,.22,.12]],
 blast:[['noise',950,90,.34,.18],['sine',105,38,.32,.18],['noise',4100,500,.11,.07]],
 bonus:[['sine',523,523,.15,.08],['sine',659,659,.15,.08,.08],['sine',880,880,.22,.08,.16]],
 reward:[['triangle',523,523,.18,.08],['triangle',659,659,.18,.08,.10],['triangle',784,784,.20,.08,.20],['sine',1047,1047,.30,.07,.30]],
 room:[['triangle',587,587,.12,.08],['triangle',784,784,.24,.08,.10]],
 shield:[['sine',1100,620,.16,.09],['noise',3200,1200,.08,.05]],
 heal:[['sine',440,660,.20,.08],['sine',660,990,.24,.07,.10]],
 jump:[['sweep',190,850,.17,.10]],
 summon:[['triangle',230,120,.26,.10],['sine',460,300,.30,.06]],
 pulse:[['sine',180,55,.28,.13],['noise',1200,300,.19,.08]],
 portal:[['sine',640,1440,.18,.08],['sine',1200,440,.22,.06,.06]],
 skill0:[['sweep',280,1750,.20,.11],['noise',2200,850,.16,.07]],
 skill1:[['sine',1100,1600,.16,.09],['sine',1500,2200,.17,.07,.045],['sine',1900,2700,.18,.06,.09]],
 skill2:[['triangle',190,80,.12,.09]],
 skill3:[['sweep',1300,260,.16,.10],['sweep',260,1250,.18,.08,.10]],
 skill4:[['sweep',550,85,.23,.13]],
 skill5:[['triangle',850,280,.11,.11],['sine',370,1300,.20,.07,.07]],
 skill6:[['noise',2500,350,.30,.12],['sweep',380,730,.18,.07]],
 skill7:[['triangle',240,65,.26,.13],['sine',120,48,.22,.10]],
 skill8:[['sine',380,740,.19,.08],['sine',520,1040,.20,.07,.07]],
 skill9:[['sweep',1550,200,.25,.10],['sweep',200,1450,.17,.09,.16]],
 skill10:[['triangle',650,150,.25,.10],['noise',4500,900,.17,.07]],
 skill11:[['noise',3800,1800,.08,.09],['triangle',980,160,.23,.09,.05]],
 spell0:[['sine',880,1320,.17,.08],['sine',1320,1760,.21,.07,.09]],
 spell1:[['noise',6200,1700,.22,.08],['sine',2100,1100,.25,.07]],
 spell2:[['sweep',600,70,.33,.12],['noise',1400,150,.26,.10]],
 spell3:[['sine',120,750,.28,.11],['sine',240,1500,.22,.06]],
 spell4:[['triangle',330,70,.18,.11]],
};
let audioBus=null,audioNoise=null,audioVoices=new Set(),audioRecent=new Map(),audioPending=false;
function audioLevel(){return sv.muted?0:Math.pow(sv.volume/100,1.6)*.8}
function syncAudio(){if(!audioBus||!audio)return;try{audioBus.gain.cancelScheduledValues(audio.currentTime);audioBus.gain.setTargetAtTime(document.hidden?0:audioLevel(),audio.currentTime,.015)}catch(e){}}
function stopAudio(){for(const voice of audioVoices){try{voice.stop()}catch(e){}}audioRecent.clear();syncAudio()}
function unlockAudio(){if(sv.muted||document.hidden)return false;try{if(!audio){const C=window.AudioContext||window.webkitAudioContext;if(!C)return false;audio=new C();audioBus=audio.createGain();const limiter=audio.createDynamicsCompressor();limiter.threshold.value=-15;limiter.ratio.value=5;audioBus.connect(limiter);limiter.connect(audio.destination);audioBus.gain.value=audioLevel();audioNoise=audio.createBuffer(1,Math.ceil(audio.sampleRate*.5),audio.sampleRate);const samples=audioNoise.getChannelData(0);let seed=18467;for(let i=0;i<samples.length;i++){seed=(Math.imul(seed,1664525)+1013904223)>>>0;samples[i]=seed/2147483648-1}}if(audio.state!=='running'&&!audioPending){audioPending=true;Promise.resolve(audio.resume()).catch(()=>{}).finally(()=>{audioPending=false})}syncAudio();return true}catch(e){return false}}
function playRecipe(recipe,key,scale=1){if(sv.muted||document.hidden||sv.volume===0||!audio||audio.state!=='running'||!audioBus)return false;try{const now=audio.currentTime;if(now-(audioRecent.get(key)??-10)<(key==='blast'?.09:.045))return false;audioRecent.set(key,now);for(const [type,f,end,d,vol,delay=0] of recipe){if(audioVoices.size>=24)break;const n=now+delay,amp=audio.createGain();let o,filter=null;if(type==='noise'){o=audio.createBufferSource();o.buffer=audioNoise;filter=audio.createBiquadFilter();filter.type='lowpass';filter.frequency.setValueAtTime(f,n);filter.frequency.exponentialRampToValueAtTime(end,n+d);o.connect(filter);filter.connect(amp)}else{o=audio.createOscillator();o.type=type==='sweep'?'triangle':type;o.frequency.setValueAtTime(f,n);o.frequency.exponentialRampToValueAtTime(end,n+d);o.connect(amp)}amp.gain.setValueAtTime(.0001,n);amp.gain.linearRampToValueAtTime(Math.max(.0002,vol*scale),n+.008);amp.gain.exponentialRampToValueAtTime(.0001,n+d);amp.connect(audioBus);audioVoices.add(o);o.onended=()=>{audioVoices.delete(o);o.disconnect();amp.disconnect();filter?.disconnect()};o.start(n);o.stop(n+d+.012)}return true}catch(e){return false}}
function cue(key,scale=1){const r=AUDIO_RECIPES[key];return r?playRecipe(r,key,scale):false}
function sound(f=440,d=.12,v=.03,type='triangle'){return playRecipe([[type,f,Math.max(30,f*.45),d,v]],'ui')}
// Unlock on a trusted interaction; never call resume repeatedly from physics.
for(const ev of ['pointerdown','keydown','click'])document.addEventListener(ev,unlockAudio,{capture:true,passive:true});

function label(x,y,s,col='#fff1ad'){labels.push({x,y,s,col,t:1.1})}function points(n,x,y){score+=n;meter+=n;label(x,y,'+'+n);while(meter>=4500){meter-=4500;stock[activeFlock.reduce((a,b)=>stock[a]<=stock[b]?a:b)]++;label(240,190,'THÊM THẺ!');deck()}dirty=true}
function burst(x,y,col,n=18,v=210,kind='chip'){if(reduced)n=Math.ceil(n/2);for(let i=0;i<n;i++){let a=rnd(0,Math.PI*2),s=rnd(25,v),life=rnd(.35,1);fx.push({x,y,vx:Math.cos(a)*s,vy:Math.sin(a)*s,r:kind==='smoke'?rnd(8,20):rnd(2,6),life,max:life,col,kind,a:rnd(0,6)})}if(fx.length>300)fx.splice(0,fx.length-300)}
function ring(x,y,r,col){rings.push({x,y,r,col,t:0})}function impact(x,y,s=6,big=false){if(reduced)return;shake=Math.max(shake,s);if(sv.dynamic){ix=x;iy=y;focus=.55}if(big)slow=.28}
function hurt(b,d){if(b.dead||!['enemy','block','tnt'].includes(b.kind)||d<=0)return;if(b.kind==='enemy'&&b.type===3&&shield()&&d<9000){d*=.25;cue('shield',.65);ring(b.x,b.y,b.r+18,'#b3efff')}if(b.kind==='enemy')b.artHit=time+.32;b.hp-=d;dirty=true;if(b.kind==='enemy'&&b.type===3&&bossMode===1&&!b.triggered&&b.hp<b.max*.5&&b.hp>0){b.triggered=true;b.artCast=time+.6;cue('heal');ring(b.x,b.y,90,'#a8ffb7');b.hp=Math.min(b.max,b.hp+b.max*.25);label(b.x,b.y-55,'HỒI PHỤC','#a8ffb7')}if(b.hp>0)return;b.dead=true;if(b.kind==='tnt'){queue.push({x:b.x,y:b.y,t:.07,p:1});points(250,b.x,b.y-15);return}if(b.kind==='enemy')runKills++;burst(b.x,b.y,b.kind==='enemy'?'#aed37e':M[b.mat][2],18,210);burst(b.x,b.y,'#f6e7c5',6,100,'smoke');points(b.kind==='enemy'?(b.type===3?3500:b.type===1?1400:1000):b.mat==='iron'?340:b.mat==='stone'?240:150,b.x,b.y-20);if(b.kind==='enemy'&&b.type===3)impact(b.x,b.y,11,true);cue(b.kind==='enemy'?(b.type===3?'boss':'enemy'):b.mat)}
function blast(x,y,r,dmg,force,skip=null){for(let b of bodies){if(b.dead||!b.inv||b===skip)continue;let dx=b.x-x,dy=b.y-y,d=Math.hypot(dx,dy);if(d>=r)continue;let f=1-d/r;b.vx+=dx/(d||1)*f*force*b.inv;b.vy+=(dy/(d||1)*f*force-100*f)*b.inv;hurt(b,dmg*f)}burst(x,y,'#ffb65b',32,400,'spark');burst(x,y,'#fff0ab',18,260,'spark');burst(x,y,'#998078',16,170,'smoke');ring(x,y,r,'#ffdf91');impact(x,y,10,true);cue('blast')}
function begin(){state='flight';flight=quiet=clear=trailAt=0;drag=null;used=false;trail=[];deck();dirty=true}
function launch(){if(!drag||paused||state!=='aim'||!canShoot()){drag=null;return false}let dx=SX-drag.x,dy=SY-drag.y;if(Math.hypot(dx,dy)<12){drag=null;return false}shot=make(drag.x,drag.y,36,36,{r:18,kind:'bird',type:sel,mass:sel===2?2.3:1.7,hp:999,power:powerOf(sel)});shot.vx=dx*9.5;shot.vy=dy*9.5;if(bonusSelected){bonusBird=-1;bonusSelected=false;shot.free=true}else{stock[sel]--;runShots++}runXP[sel]+=20;begin();cue('launch');hud();return true}
function cast(p){if(paused||state!=='aim'||spell<0||!sv.spells[spell]||p.x<270||p.x>W||p.y<50||p.y>F+30)return false;let i=spell;sv.spells[i]--;persist();spell=-1;shot=null;begin();used=true;let col=S[i][2];label(p.x,Math.max(90,p.y-40),S[i][0].toUpperCase(),col);if(i===0)for(let j=0;j<12;j++){let b=make(410+j*44,-60-j%4*50,28,28,{r:14,kind:'magic',mass:1.5,hp:999});b.vy=rnd(320,520)}if(i===1){for(let b of bodies)if(!b.dead&&b.kind==='block'){let f=b.hp/b.max;b.mat='ice';b.hp=Math.max(8,48*f);b.max=48;b.m=Math.max(.35,b.w*b.h*.7/1000);b.inv=1/b.m;b.ii=12/(b.m*(b.w*b.w+b.h*b.h));burst(b.x,b.y,col,7,125,'spark')}ring(690,330,320,col)}if(i===2){let b=make(p.x,-60,62,62,{r:31,kind:'meteor',mass:8,hp:999,fuse:3});b.vy=850}if(i===3){for(let b of bodies){if(!b.inv||b.dead)continue;let d=Math.hypot(b.x-p.x,b.y-p.y);if(d<245){let f=1-d/245;b.vy-=720*f;b.vx+=(b.x-p.x)/(d||1)*280*f;hurt(b,45*f)}}ring(p.x,p.y,245,col);burst(p.x,p.y,col,30,280,'spark')}if(i===4)blast(p.x,p.y,215,570,1020);cue('spell'+i);hud();deck();return true}
function skill(){if(paused)return false;if(rescue||(state==='aim'&&!hasShots()&&spell<0)){outOfAmmo();return false}if(spell>=0){spell=-1;deck();return}if(paused||state!=='flight'||used||!shot||shot.dead)return false;let b=shot;if([8,9,11].includes(b.type)&&!nearTargets(b).length){label(b.x,b.y-35,'CHƯA CÓ MỤC TIÊU','#fff1ad');return false}used=true;b.skillVisualAt=time;skillArt.push({x:b.x,y:b.y,i:b.type,a:Math.atan2(b.vy,b.vx),start:time});let p=b.power,a=Math.atan2(b.vy,b.vx),v=Math.max(470,Math.hypot(b.vx,b.vy)),col=pal(b.type)[1];switch(b.type){case 0:b.vx=Math.cos(a)*1280;b.vy=Math.sin(a)*1280;break;case 1:for(let d of [-.3,.3]){let z=make(b.x-Math.sin(a)*d*125,b.y+Math.cos(a)*d*125,24,24,{r:12,kind:'bird',type:1,mass:.85,hp:999,power:p});z.vx=Math.cos(a+d)*v;z.vy=Math.sin(a+d)*v}break;case 2:blast(b.x,b.y,185,530*p,980,b);b.dead=true;break;case 3:b.vx=b.vx>=0?-Math.max(650,v):Math.max(650,v);b.vy=-170;break;case 4:b.vx*=.15;b.vy=1250;b.m=3.8;b.inv=1/b.m;b.ii=2/(b.m*b.r*b.r);break;case 5:{let z=make(b.x,b.y+32,24,24,{r:12,kind:'bomb',mass:1.9,hp:999,fuse:1.25,power:p});z.vx=b.vx*.23;z.vy=Math.max(220,b.vy*.3);b.vy=-470;b.vx*=.7;break}case 6:{let dir=b.vx>=0?1:-1;for(let z of bodies){if(z.dead||!z.inv||z===b||z.kind==='bird')continue;let dx=(z.x-b.x)*dir;if(dx>-25&&dx<385&&Math.abs(z.y-b.y)<175){let f=1-Math.max(dx,0)/450;z.vx+=dir*f*670*z.inv*p;z.vy-=110*f;hurt(z,25*f*p)}}break}case 8:case 9:case 10:case 11:newSkill(b);break;case 7:b.r=34;b.w=b.h=68;b.m=6;b.inv=1/6;b.ii=2/(6*34*34);b.vx*=1.1;b.vy*=1.1;break}ring(b.x,b.y,b.type===6?200:80,col);burst(b.x,b.y,col,24,230,'spark');label(b.x,b.y-45,B[b.type][1].toUpperCase(),col);cue('skill'+b.type);deck();return true}$('power').onclick=skill;
function nearTargets(b){let [radius,n]=({8:[205,4],9:[285,5],11:[320,3]})[b.type]||[0,0];return bodies.filter(z=>!z.dead&&z.inv&&['block','enemy','tnt'].includes(z.kind)&&Math.hypot(z.x-b.x,z.y-b.y)<radius).sort((a,c)=>Math.hypot(a.x-b.x,a.y-b.y)-Math.hypot(c.x-b.x,c.y-b.y)).slice(0,n)}
function newSkill(b){
const dir=b.vx<0?-1:1;
if(b.type===8){let targets=nearTargets(b);for(let z of targets){z.vy=-190;z.vx*=.3;effects.push({kind:'bubble',target:z,t:1.2,p:b.power});ring(z.x,z.y,Math.max(z.w,z.h)/2+12,'#f7b9ec')}}
if(b.type===9){let targets=nearTargets(b);for(let z of targets)effects.push({kind:'suction',target:z,bird:b,t:.52,p:b.power,dir});b.vx*=.22;b.vy*=.2;ring(b.x,b.y,285,'#a3fff0')}
if(b.type===10){b.phaseUntil=sim+.55;b.vx=dir*Math.max(850,Math.abs(b.vx));b.vy*=.35;effects.push({kind:'phase',bird:b,t:.55,p:b.power});ring(b.x,b.y,65,'#dbeaff')}
if(b.type===11){let targets=nearTargets(b);for(let z of targets)effects.push({kind:'tether',target:z,bird:b,t:.75,p:b.power});b.vx*=.18;b.vy*=.2;ring(b.x,b.y,320,'#ffe0a0')}
}
function tickEffects(){for(let e of effects){let z=e.target,b=e.bird;e.t-=DT;if(e.kind==='phase'){if(e.t<=0&&!b.dead){b.phaseUntil=0;blast(b.x,b.y,115,190*e.p,450,b)}continue}if(z.dead){e.t=0;continue}if(e.kind==='bubble'){if(e.t>0){z.vy=Math.max(-260,z.vy-950*DT);z.vx*=.993}else{hurt(z,35*e.p);ring(z.x,z.y,60,'#f7b9ec');burst(z.x,z.y,'#f7b9ec',12,100,'spark')}continue}if(!b||b.dead){e.t=0;continue}let dx=b.x-z.x,dy=b.y-z.y,d=Math.max(25,Math.hypot(dx,dy));if(e.t>0){let force=(e.kind==='tether'?1700:2200)*e.p/Math.sqrt(z.m);z.vx+=dx/d*force*DT;z.vy+=dy/d*force*DT}else if(e.kind==='suction'){z.vx=e.dir*850;z.vy=-120;hurt(z,45*e.p);ring(z.x,z.y,60,'#a3fff0')}else hurt(z,25*e.p)}effects=effects.filter(e=>e.t>0)}
function drawEffects(){if(state==='flight'&&shot&&!shot.dead&&!used&&[8,9,11].includes(shot.type)){const radius=({8:205,9:285,11:320})[shot.type],ready=nearTargets(shot).length>0;g.save();g.globalAlpha=ready?.8:.33;g.setLineDash([7,9]);ringVisual(shot.x,shot.y,radius,pal(shot.type)[1]);g.setLineDash([]);g.restore()}for(let e of effects){let z=e.target,b=e.bird;if(e.kind==='phase'&&!b.dead){ringVisual(b.x,b.y,38,'#dbeaff');continue}if(!z||z.dead)continue;if(e.kind==='bubble'){let r=Math.hypot(z.w,z.h)/2+8;ell(z.x,z.y,r,r,'#f0b5ed25');ringVisual(z.x,z.y,r,'#ffd6f7');ell(z.x-r*.4,z.y-r*.5,r*.14,r*.08,'#fff9ff')}else if(b&&!b.dead){line(b.x,b.y,z.x,z.y,e.kind==='tether'?'#fff0b9':'#92f8e5',e.kind==='tether'?3:2)}}}
function ringVisual(x,y,r,col){g.beginPath();g.arc(x,y,r,0,Math.PI*2);g.strokeStyle=col;g.lineWidth=2;g.stroke()}
function verts(b){let co=Math.cos(b.a),si=Math.sin(b.a),x=b.w/2,y=b.h/2;return[[-x,-y],[x,-y],[x,y],[-x,y]].map(p=>({x:b.x+p[0]*co-p[1]*si,y:b.y+p[0]*si+p[1]*co}))}
function proj(v,n){let lo=Infinity,hi=-Infinity;for(let p of v){let d=dot(p,n);lo=Math.min(lo,d);hi=Math.max(hi,d)}return[lo,hi]}
function contact(a,b){if(a.dead||b.dead||a.phaseUntil>sim||b.phaseUntil>sim||(!a.inv&&!b.inv))return null;let ra=a.r||Math.hypot(a.w,a.h)/2,rb=b.r||Math.hypot(b.w,b.h)/2;if(Math.abs(a.x-b.x)>ra+rb||Math.abs(a.y-b.y)>ra+rb)return null;if(a.r&&b.r){let dx=b.x-a.x,dy=b.y-a.y,d=Math.hypot(dx,dy),dep=a.r+b.r-d;if(dep<=0)return null;let n=d>1e-6?{x:dx/d,y:dy/d}:{x:1,y:0};return{a,b,n,dep,pts:[{x:a.x+n.x*(a.r-dep*.5),y:a.y+n.y*(a.r-dep*.5)}]}}if(a.r||b.r){let s=a.r?a:b,q=a.r?b:a,co=Math.cos(q.a),si=Math.sin(q.a),dx=s.x-q.x,dy=s.y-q.y,lx=dx*co+dy*si,ly=-dx*si+dy*co,hx=q.w/2,hy=q.h/2,x=clamp(lx,-hx,hx),y=clamp(ly,-hy,hy),nx=x-lx,ny=y-ly,d=Math.hypot(nx,ny),dep;if(d>1e-6){dep=s.r-d;if(dep<=0)return null;nx/=d;ny/=d}else{let ex=hx-Math.abs(lx),ey=hy-Math.abs(ly);if(ex<ey){nx=lx>=0?-1:1;ny=0;x=lx>=0?hx:-hx;dep=s.r+ex}else{nx=0;ny=ly>=0?-1:1;y=ly>=0?hy:-hy;dep=s.r+ey}}let n={x:nx*co-ny*si,y:nx*si+ny*co};if(s!==a){n.x*=-1;n.y*=-1}return{a,b,n,dep,pts:[{x:q.x+x*co-y*si,y:q.y+x*si+y*co}]}}
let va=verts(a),vb=verts(b),dep=Infinity,n=null;for(let v of [va,vb])for(let i=0;i<2;i++){let p=v[i],q=v[i+1],dx=q.x-p.x,dy=q.y-p.y,d=Math.hypot(dx,dy),axis={x:-dy/d,y:dx/d},pa=proj(va,axis),pb=proj(vb,axis),forward=pa[1]-pb[0],back=pb[1]-pa[0],o=Math.min(forward,back);if(o<=0)return null;if(o<dep){dep=o;n=forward<=back?axis:{x:-axis.x,y:-axis.y}}}let t={x:-n.y,y:n.x},pa=proj(va,n),pb=proj(vb,n),fa=va.filter(p=>pa[1]-dot(p,n)<1.5),fb=vb.filter(p=>dot(p,n)-pb[0]<1.5),ta=proj(fa,t),tb=proj(fb,t),lo=Math.max(ta[0],tb[0]),hi=Math.min(ta[1],tb[1]),plane=(pa[1]+pb[0])/2;return{a,b,n,dep,pts:(hi-lo>10?[lo+1,hi-1]:[(lo+hi)/2]).map(z=>({x:n.x*plane+t.x*z,y:n.y*plane+t.y*z}))}}
const vel=(b,r)=>({x:b.vx-b.av*r.y,y:b.vy+b.av*r.x});function impulse(b,j,r,s){if(!b.inv)return;b.vx+=s*j.x*b.inv;b.vy+=s*j.y*b.inv;b.av+=s*cross(r,j)*b.ii}function factor(b,s){return s.kind==='bird'?s.power*(s.type===0&&b.mat==='wood'?1.7:s.type===1&&b.mat==='ice'?2.2:s.type===4||s.type===7?1.6:1.12):1}
function solve(k,first){let{a,b,n}=k;if(a.dead||b.dead)return;for(let p of k.pts){if(a.dead||b.dead)break;let ra={x:p.x-a.x,y:p.y-a.y},rb={x:p.x-b.x,y:p.y-b.y},va=vel(a,ra),vb=vel(b,rb),vn=dot({x:vb.x-va.x,y:vb.y-va.y},n);if(vn>=0)continue;let dn=a.inv+b.inv+cross(ra,n)**2*a.ii+cross(rb,n)**2*b.ii;if(dn<1e-8)continue;let j=-(1+(first&&vn< -100?.12:0))*vn/dn,J={x:n.x*j,y:n.y*j};impulse(a,J,ra,-1);impulse(b,J,rb,1);let q={x:-n.y,y:n.x},v1=vel(a,ra),v2=vel(b,rb),vt=dot({x:v2.x-v1.x,y:v2.y-v1.y},q),dd=a.inv+b.inv+cross(ra,q)**2*a.ii+cross(rb,q)**2*b.ii;if(dd>0){let mu=a.mat==='ice'||b.mat==='ice'?.3:.64,jt=clamp(-vt/dd,-j*mu,j*mu),T={x:q.x*jt,y:q.y*jt};impulse(a,T,ra,-1);impulse(b,T,rb,1)}if(first&&-vn>85){let key=a.id+':'+b.id;if(sim-(hits.get(key)??-10)>.14){hits.set(key,sim);for(const z of [a,b])if(z.kind==='bird'&&-vn>180)z.impactVisualAt=time;let d=Math.min(410,(-vn-65)*.36+j*.035);hurt(a,d*factor(a,b));hurt(b,d*factor(b,a));for(let z of [a,b]){if(z.kind==='bomb')z.fuse=Math.min(z.fuse,.1);if(z.kind==='meteor'&&!z.dead){z.dead=true;queue.push({x:z.x,y:z.y,t:.02,p:1,meteor:true})}}if(-vn>240){cue(a.kind==='block'?a.mat:b.kind==='block'?b.mat:'stone',.45);burst(p.x,p.y,'#ffe8bd',5,150,'spark');impact(p.x,p.y,Math.min(7,-vn/150))}}}}}
function bossAI(){let b=boss();if(!b)return;b.cool-=DT;if(bossMode===2&&b.cool<=0&&shot&&!shot.dead&&Math.hypot(shot.x-b.x,shot.y-b.y)<200&&Math.abs(b.vy)<75){b.vy=-340;b.vx+=shot.x<b.x?100:-100;b.cool=3.2;b.artCast=time+.45;cue('jump');label(b.x,b.y-45,'NÉ ĐÒN','#ffe5a6')}if(bossMode===3&&!b.triggered&&b.hp<b.max*.6){b.triggered=true;b.artCast=time+.6;cue('summon');for(let x of [415,465])make(x,F-100,28,28,{kind:'enemy',type:2,r:14});label(b.x,b.y-50,'TRIỆU HỒI','#d8b6ff');ring(440,F-100,80,'#d8b6ff');dirty=true}if(bossMode===4&&b.cool<=0&&shot&&!shot.dead&&Math.hypot(shot.x-b.x,shot.y-b.y)<230){b.cool=3;b.artCast=time+.6;cue('pulse');for(let z of bodies){if(z.dead||z.kind!=='bird')continue;let dx=z.x-b.x,dy=z.y-b.y,d=Math.hypot(dx,dy);if(d<230){let f=1-d/230;z.vx+=dx/(d||1)*550*f;z.vy+=dy/(d||1)*550*f}}ring(b.x,b.y,230,'#e0ccff');label(b.x,b.y-50,'SÓNG ĐẨY','#e0ccff')}}
function step(){sim+=DT;bossAI();tickEffects();for(let b of bodies){if(b.dead)continue;if(!b.inv){if(b.moving){let x=b.ox+Math.sin(sim*1.4)*b.moving;b.vx=(x-b.x)/DT;b.x=x}else b.vx=0;continue}if(['bird','bomb'].includes(b.kind)){for(let w of winds)if(b.x>w.x&&b.x<w.x+w.w&&b.y>w.y&&b.y<w.y+w.h){b.vx+=w.ax*DT;b.vy+=w.ay*DT}if(sim-b.gate>.7)for(let pair of portals){let i=pair.findIndex(p=>Math.hypot(b.x-p.x,b.y-p.y)<30);if(i>=0){ring(b.x,b.y,65,'#c8a6ff');let p=pair[1-i];b.x=p.x+(b.vx>=0?38:-38);b.y=p.y;b.gate=sim;cue('portal');ring(p.x,p.y,65,'#9df7ff');break}}}b.vy+=G*DT;b.vx*=.9995;b.av*=.998;let v=Math.hypot(b.vx,b.vy);if(v>1500){b.vx*=1500/v;b.vy*=1500/v}b.x+=b.vx*DT;b.y+=b.vy*DT;b.av=clamp(b.av,-19,19);b.a+=b.av*DT;if(['bomb','meteor'].includes(b.kind)){b.fuse-=DT;if(b.fuse<=0){b.dead=true;queue.push({x:b.x,y:b.y,t:.02,p:b.power,meteor:b.kind==='meteor'})}}}let due=[];for(let q of queue){q.t-=DT;if(q.t<=0)due.push(q)}queue=queue.filter(q=>q.t>0);for(let q of due)blast(q.x,q.y,q.meteor?185:145,(q.meteor?520:420)*q.p,q.meteor?1050:850);let live=bodies.filter(b=>!b.dead),cs=[];
// Conservative world-space bounds, evaluated once per body per fixed step.
const bounds=live.map(b=>{let co=Math.abs(Math.cos(b.a)),si=Math.abs(Math.sin(b.a));return {x:b.r||((co*b.w+si*b.h)/2),y:b.r||((si*b.w+co*b.h)/2)}});
for(let i=0;i<live.length;i++)for(let j=i+1;j<live.length;j++){let a=live[i],b=live[j];if(!a.inv&&!b.inv)continue;if(Math.abs(a.x-b.x)>bounds[i].x+bounds[j].x+1e-6||Math.abs(a.y-b.y)>bounds[i].y+bounds[j].y+1e-6)continue;let k=contact(a,b);if(k)cs.push(k)}for(let i=0;i<10;i++)for(let k of cs)solve(k,i===0);for(let k of cs){let{a,b,n,dep}=k;if(a.dead||b.dead)continue;let m=a.inv+b.inv;if(!m)continue;let d=Math.max(0,dep-.18)*.55/m;a.x-=n.x*d*a.inv;a.y-=n.y*d*a.inv;b.x+=n.x*d*b.inv;b.y+=n.y*d*b.inv}for(let b of bodies)if(!b.dead&&b.inv&&(b.x>W+160||b.x< -160||b.y>H+130||(b.kind==='enemy'&&(b.x<240||b.x>W-8)))){if(b.kind==='enemy')hurt(b,9999);else b.dead=true}if(bodies.some(b=>!b.dead&&![b.x,b.y,b.vx,b.vy,b.a,b.hp].every(Number.isFinite))){show('LỖI VẬT LÝ','Chặng gặp lỗi mô phỏng. Hãy khôi phục điểm bắt đầu chặng.','','Khôi phục chặng',retry);state='end';bodies=bodies.filter(b=>[b.x,b.y,b.a,b.hp].every(Number.isFinite));return}flight+=DT;quiet=effects.length||queue.length||bodies.some(b=>b.inv&&!b.dead&&(['bomb','meteor'].includes(b.kind)||Math.hypot(b.vx,b.vy)>35||Math.abs(b.av)>1))?0:quiet+DT;if(!count()){clear+=DT;if(clear>1.05&&!queue.length)win()}else if((flight>12&&!effects.length&&!queue.length&&!bodies.some(b=>!b.dead&&['bomb','meteor'].includes(b.kind)))||(flight>1.5&&quiet>1))finish()}
function finish(){effects=[];bodies=bodies.filter(b=>!b.dead&&!['bird','bomb','magic','meteor'].includes(b.kind));for(let b of bodies)b.vx=b.vy=b.av=0;shot=null;state='aim';used=false;trail=[];focus=slow=0;hits.clear();choose();if(!hasShots())outOfAmmo();deck();dirty=true}
function outOfAmmo(){rescue=false;spell=-1;show('HẾT LƯỢT BẮN','Thêm thẻ miễn phí nếu còn, chơi lại chặng, dùng phép hoặc nhận cứu trợ. Nếu dùng cứu trợ, màn này tối đa 1 sao.','','Chơi lại chặng',retry);let d=$('content');d.innerHTML=`<div class="menu">${bonusLeft?'<button id="bonusRecovery">＋ Thêm thẻ miễn phí</button>':''}<button id="rescueBtn">Cứu trợ miễn phí</button><button id="spellBtn" ${sv.spells.some(x=>x>0)?'':'disabled'}>Dùng phép đang có</button><button id="restartLevel">Chơi lại cả màn</button><button id="returnMap">Bản đồ</button></div>`;if(bonusLeft)$('bonusRecovery').onclick=drawBonus;$('rescueBtn').onclick=enableRescue;$('spellBtn').onclick=()=>{tab=1;spell=-1;close();deck()};$('restartLevel').onclick=()=>start(level);$('returnMap').onclick=map}
function enableRescue(){if(state!=='aim'||hasShots())return false;rescue=true;tab=0;spell=-1;close();deck();return true}
function rescueCast(p){if(!rescue||paused||state!=='aim'||hasShots())return false;if(p.x<0||p.x>W||p.y<0||p.y>H)return false;rescue=false;assisted=true;shot=null;begin();used=true;blast(p.x,p.y,215,620,1020);label(p.x,p.y-45,'CỨU TRỢ','#ffe0a1');deck();return true}
function win(){if(state==='end')return;state='end';cue(room===0?'room':'reward');if(room===0){show('CHẶNG HOÀN THÀNH',`Điểm ${score.toLocaleString('vi-VN')} · Còn ${ammo()} lượt`,'✦','Chặng tiếp theo',()=>{room=1;if(ammo()<2)stock[activeFlock[0]]+=2-ammo();setup()})}else{let stars=assisted?1:ammo()>=4?3:ammo()>=2?2:1,first=!sv.claimed[level],isBoss=(level+1)%10===0;score+=ammo()*300;let coins=first?100+stars*30+(isBoss?100:0):15,feathers=first?20+stars*10:5,keys=first&&isBoss?1:0;sv.coins+=coins;sv.feathers+=feathers;sv.keys+=keys;sv.wins++;sv.shots+=runShots;sv.kills+=runKills;runXP.forEach((x,i)=>sv.birds[i].xp+=x);let spellGift=first&&sv.spells[level%5]<99?1:0;if(first){sv.claimed[level]=true;sv.spells[level%5]+=spellGift}sv.stars[level]=Math.max(sv.stars[level],stars);sv.best[level]=Math.max(sv.best[level],score);while(sv.open<99&&sv.stars[sv.open]>0)sv.open++;persist();cp=null;show(level===99?'GRAND CHAMPION!':isBoss?'BOSS ĐÃ BỊ HẠ!':'CHIẾN THẮNG!',`Màn ${level+1} · ${score.toLocaleString('vi-VN')} điểm`,'★'.repeat(stars)+'☆'.repeat(3-stars),level===99?'Chiến dịch':'Màn tiếp theo',()=>level===99?map():start(Math.min(level+1,sv.open)));$('content').innerHTML=`<div class="victory-banner"><div class="victory-flock">${activeFlock.slice(0,3).map(i=>portrait(i)).join('')}</div><span>${assisted?'CỨU TRỢ · 1 SAO TỐI ĐA':first?'HOÀN THÀNH LẦN ĐẦU':'HOÀN THÀNH LẠI'}</span></div><div class="loot-grid reward-reveal"><div><span>◉</span><b>+${coins}</b><small>Vàng</small></div><div><span>❧</span><b>+${feathers}</b><small>Lông vũ</small></div>${keys?'<div><span>⚿</span><b>+1</b><small>Chìa khóa</small></div>':''}${first?`<div><span>${S[level%5][1]}</span><b>+${spellGift}</b><small>${S[level%5][0]}${spellGift?'':' · Kho đầy'}</small></div>`:''}</div><div class="receipt"><b>Kinh nghiệm nhân vật</b><div class="xp-loot">${runXP.map((x,i)=>x?`<span>${portrait(i)}<small>${B[i][0]} +${x} XP</small></span>`:'').join('')||'Không sử dụng chim'}</div></div>`}hud();deck()}
function ell(x,y,rx,ry,col){g.beginPath();g.ellipse(x,y,Math.max(.01,rx),Math.max(.01,ry),0,0,Math.PI*2);g.fillStyle=col;g.fill()}function rr(x,y,w,h,r,col,stroke=null,l=1){g.beginPath();g.roundRect(x,y,w,h,r);g.fillStyle=col;g.fill();if(stroke){g.strokeStyle=stroke;g.lineWidth=l;g.stroke()}}function line(x,y,X,Y,col,w){g.beginPath();g.moveTo(x,y);g.lineTo(X,Y);g.strokeStyle=col;g.lineWidth=w;g.lineCap='round';g.stroke()}function poly(p,col,stroke=null,w=1){g.beginPath();p.forEach((q,i)=>i?g.lineTo(...q):g.moveTo(...q));g.closePath();g.fillStyle=col;g.fill();if(stroke){g.strokeStyle=stroke;g.lineWidth=w;g.stroke()}}function gradient(x,y,X,Y,stops){let q=g.createLinearGradient(x,y,X,Y);stops.forEach(([p,col])=>q.addColorStop(p,col));return q}
// Cache static scenery per world; animate clouds and foreground separately.
const BIOMES=[
['Green Meadow','#6dc9eb','#fef5cc','#b3d8b0','#78b994','#3d886f','#8fca55','#b67f4b','meadow'],
['Tropical Harbor','#4dbbde','#f8edc0','#a9d4d0','#6bb9b8','#318b8b','#76bd60','#c69b62','harbor'],
['Snowfall Pass','#80b7df','#e9faff','#d3e5ee','#9cbdd4','#668cae','#e3f3f6','#8aacc1','snow'],
['Crystal Cavern','#7285bf','#b7e8e9','#9eb6d6','#7398bd','#536a9b','#a5e7df','#7b809d','crystal'],
['Golden Canyon','#ed9b59','#fff1b5','#efbd8d','#ce8d64','#aa6650','#e4c275','#b87c48','canyon'],
['Festival Grove','#e9a5a0','#ffedd4','#e9c4b7','#b897aa','#897e9d','#b5c678','#b48874','festival'],
['Moonlit Forest','#414a88','#b6c8dd','#9295bd','#628a9f','#385c70','#79a48f','#746783','moon'],
['Haunted Marsh','#456b83','#c2d8c9','#a5beb0','#648d87','#3e6967','#92b988','#6c7870','marsh'],
['Royal Fortress','#778bb9','#e8c9b5','#b6a7bf','#8a8da5','#626580','#a6b477','#938074','fortress'],
['Sky Sanctuary','#5885cb','#dce4f8','#c0b9e5','#8e9bce','#637bb3','#a0c6bc','#8b92b1','sky']];
const theme=()=>BIOMES[Math.floor(level/10)];
const bgCache=new Map();
const artURL=name=>typeof FF_ART!=='undefined'&&FF_ART[name]?FF_ART[name]:'assets/'+name+'.webp';
const artImages=new Map();
function art(name){if(typeof Image==='undefined')return null;if(!artImages.has(name)){let im=new Image();im.onload=()=>{dirty=true};im.src=artURL(name);artImages.set(name,im)}let im=artImages.get(name);return im.complete&&im.naturalWidth?im:null}
// Release references to heavy images from the previous room. Active assets load lazily.
function trimArt(){for(const [name,im] of artImages){if(name.startsWith('anim-bird-')||name.startsWith('enemy-atlas-')||name.startsWith('illustrated-zone-')&&name!==sceneName(Math.floor(level/10))){im.onload=null;artImages.delete(name)}}for(const [k,cv] of bgCache){if(k!==Math.floor(level/10)){cv.width=cv.height=1;bgCache.delete(k)}}}
const sceneName=k=>'illustrated-zone-'+k;
const mapScene=k=>'route-zone-'+k;

function scenery(k){if(bgCache.has(k))return bgCache.get(k);let cv=document.createElement('canvas');cv.width=W;cv.height=H;let p=cv.getContext('2d'),z=BIOMES[k],seed=3791+k*911;
const random=()=>{seed=(Math.imul(seed,1664525)+1013904223)>>>0;return seed/4294967296};
function oval(x,y,rx,ry,col){p.beginPath();p.ellipse(x,y,rx,ry,0,0,6.283);p.fillStyle=col;p.fill()}
function polygon(pts,col){p.beginPath();pts.forEach(([x,y],i)=>i?p.lineTo(x,y):p.moveTo(x,y));p.closePath();p.fillStyle=col;p.fill()}
function stroke(pts,col,w){p.beginPath();pts.forEach(([x,y],i)=>i?p.lineTo(x,y):p.moveTo(x,y));p.strokeStyle=col;p.lineWidth=w;p.lineCap='round';p.stroke()}
function rect(x,y,w,h,col){p.fillStyle=col;p.fillRect(x,y,w,h)}
let gr=p.createLinearGradient(0,0,0,H);gr.addColorStop(0,z[1]);gr.addColorStop(.7,z[2]);gr.addColorStop(1,z[3]);rect(0,0,W,H,gr);
let sun=p.createRadialGradient(760,115,15,760,115,135);sun.addColorStop(0,'#fff7d6b0');sun.addColorStop(1,'#fff7d600');rect(600,0,360,280,sun);oval(760,115,k===6||k===7?32:43,k===6||k===7?32:43,'#fff5d3');
if(k>=6&&k<=7)for(let i=0;i<60;i++)oval(random()*W,40+random()*250,1+random(),1+random(),'#fff4d49a');
for(let l=0;l<3;l++){let pts=[[0,H]];for(let x=-16;x<=W+16;x+=16){let h=k===2||k===4?Math.abs(Math.sin(x*.009+l))*125+Math.abs(Math.cos(x*.025))*22:Math.sin(x*.009+l)*48+Math.cos(x*.023+l)*25;pts.push([x,275+l*87-h])}pts.push([W,H]);polygon(pts,z[3+l]);}
// Distinct distant silhouettes; keep high-contrast playable objects in front.
if(k===1||k===7){rect(0,420,W,180,k===1?'#70b8c8':'#729c9d');for(let i=0;i<55;i++){let x=random()*W,y=425+random()*170;stroke([[x,y],[x+8+random()*36,y]],'#e3ffff45',1.5)}}
for(let i=0;i<13;i++){let x=i*82-20+random()*19,y=465+random()*28,h=65+random()*85;
if([0,5,6,7].includes(k)){stroke([[x,y],[x+7,y-h*.65],[x-5,y-h]],k===6?'#425f70':'#667e68',10);stroke([[x+3,y-h*.56],[x-28,y-h*.85]],'#627767',5);for(let j=0;j<5;j++){let a=j*1.25;oval(x+Math.cos(a)*27,y-h+Math.sin(a)*20,28,25,k===5?'#d8a8b4':z[5]);}oval(x-12,y-h-18,24,17,k===5?'#f4c9cc':'#e5efc72c');if(k===6||k===7)for(let j=0;j<3;j++)oval(x+random()*40-20,y-h*.6+random()*60,2,2,'#f4f3a7')}
else if(k===1){stroke([[x,y],[x+12,y-h*.5],[x+4,y-h]],'#907c60',9);for(let j=0;j<6;j++){let a=j*1.05;polygon([[x+4,y-h],[x+Math.cos(a)*53,y-h+Math.sin(a)*28],[x+Math.cos(a+.35)*32,y-h+Math.sin(a+.35)*18]],'#549c78')}}
